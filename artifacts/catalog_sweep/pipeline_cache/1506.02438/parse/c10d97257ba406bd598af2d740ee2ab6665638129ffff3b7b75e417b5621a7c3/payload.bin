ng Systems</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2009\">2009</date>\n\t\t\t<biblScope unit=\"page\" from=\"1204\" to=\"1212\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b4\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Variance reduction techniques for gradient estimates in reinforcement learning</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Evan</forename><surname>Greensmith</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Bartlett</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">L</forename><surname>Peter</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jonathan</forename><surname>Baxter</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">The Journal of Machine Learning Research</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">5</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"1471\" to=\"1530\" />\n\t\t\t<date type=\"published\" when=\"2004\">2004</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b5\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Reinforcement learning in feedback control</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Roland</forename><surname>Hafner</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Martin</forename><surname>Riedmiller</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Machine learning</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">84</biblScope>\n\t\t\t<biblScope unit=\"issue\">1-2</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"137\" to=\"169\" />\n\t\t\t<date type=\"published\" when=\"2011\">2011</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b6\">\n\t<monogr>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Nicolas</forename><surname>Heess</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Greg</forename><surname>Wayne</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Silver</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>David</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Lillicrap</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Timothy</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Tassa</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Tom</forename><surname>Erez</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:1510.09142</idno>\n\t\t<title level=\"m\">Learning continuous control policies by stochastic value gradients</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2015\">2015</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b7\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Principles of behavior</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Clark</forename><surname>Hull</surname></persName>\n\t\t</author>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"1943\">1943</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b8\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">A natural policy gradient</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Sham</forename><surname>Kakade</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">NIPS</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2001\">2001</date>\n\t\t\t<biblScope unit=\"volume\">14</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"1531\" to=\"1538\" />\n\t\t</imprint>\n\t</monogr>