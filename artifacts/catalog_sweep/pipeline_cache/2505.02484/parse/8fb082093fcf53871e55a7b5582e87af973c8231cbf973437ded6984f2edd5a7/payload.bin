\t\t<persName><forename type=\"first\">Errol</forename><forename type=\"middle\">G</forename><surname>Lewars</surname></persName>\n\t\t</author>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2010-11\">November 2010</date>\n\t\t\t<publisher>zwDCWvnbrQwC</publisher>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b4\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">The central role of density functional theory in the AI age</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Bing</forename><surname>Huang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Guido</forename><surname>Falk Von Rudorff</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">O</forename><surname>Anatole Von Lilienfeld</surname></persName>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.1126/science.abn3445</idno>\n\t\t<ptr target=\"https://www.science.org/doi/10.1126/science.abn3445\" />\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Science</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">381</biblScope>\n\t\t\t<biblScope unit=\"issue\">6654</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"170\" to=\"175\" />\n\t\t\t<date type=\"published\" when=\"2023-07\">July 2023</date>\n\t\t\t<publisher>American Association for the Advancement of Science</publisher>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b5\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Identification of unknown inverted singlet-triplet cores by high-throughput virtual screening</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">H</forename><surname>Ömer</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Xiaoyu</forename><surname>Omar</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Alessandro</forename><surname>Xie</surname></persName>