no>abs/2302.05737</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2023\">2023</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">ArXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b105\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">SCALING BOTH DATA AND MODEL SIZE As an extension of Table 1, we show the accuracy of AR and MGDM when both data and model size are increased in Table 8. We find scaling both data and model size is effective for both AR and MGDM. Table 8: Results of scaling both model and data size</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">D</forename></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">AR MGDM 85M model, 500k data 45.8 91.5 303M model</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>500k data 41.3 88.3 303M model, 1M data 53.3 95.6</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b106\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Example predictions on Countdown 4. For each sub-equation, we mark the planning error in red and the calculation error in bold. AR exhibits more calculation errors in the last equation due to incorrect planning in the previous steps</title>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Numbers Goal Groundtruth AR Prediction MGDM Prediction</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">9</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"64\" to=\"52\" />\n\t\t</imprint>\n\t</monogr>\n\t<note>D.4 CASE STUDY Table</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b107\">\n\t<monogr>\n\t\t<title level=\"m\">/36=2</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">52</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"42\" to=\"68\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b108\">\n\t<monogr>\n\t\t<idno>+21=57 52-20=32</idno>\n\t\t<title level=\"m\">*20=40</title>\n\t\t<imprint>\n\t\t\t<biblSco