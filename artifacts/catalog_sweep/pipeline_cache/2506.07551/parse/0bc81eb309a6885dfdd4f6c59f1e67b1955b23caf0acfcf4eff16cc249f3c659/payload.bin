ll></cell></row><row><cell>-v1</cell><cell></cell><cell cols=\"2\">93.97</cell><cell cols=\"6\">88.31 97.06 89.02 92.86 88.12</cell><cell>70.98</cell><cell></cell></row><row><cell>-v2</cell><cell></cell><cell cols=\"2\">86.21</cell><cell cols=\"6\">79.89 97.49 83.69 90.07 79.98</cell><cell>64.37</cell><cell></cell></row><row><cell>-v3</cell><cell></cell><cell cols=\"2\">88.79</cell><cell cols=\"6\">82.66 97.22 84.97 90.69 82.47</cell><cell>63.98</cell><cell></cell></row><row><cell cols=\"2\">Llama-3.1-8B-I*</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row><row><cell>-v1</cell><cell></cell><cell cols=\"2\">97.89</cell><cell cols=\"6\">93.87 97.93 92.65 95.22 94.25</cell><cell>68.30</cell><cell></cell></row><row><cell>-v2</cell><cell></cell><cell cols=\"2\">97.99</cell><cell cols=\"6\">93.49 97.80 92.65 95.16 94.16</cell><cell>72.41</cell><cell></cell></row><row><cell>-v3</cell><cell></cell><cell cols=\"2\">97.89</cell><cell cols=\"6\">93.87 98.08 92.79 95.36 94.54</cell><cell>69.25</cell><cell></cell></row><row><cell>Model</cell><cell>Format</cell><cell>P</cell><cell>Tool R</cell><cell>F1</cell><cell>P</cell><cell>Param R</cell><cell>F1</cell><cell>P</cell><cell>Return R</cell><cell>F1</cell><cell>Pass Rate</cell></row><row><cell>ChemLLM-1*</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row><row><cell>-v1</cell><cell>98.50</cell><cell cols=\"9\">56.98 89.51 69.64 50.43 81.60 62.34 51.74 82.51 63.60</cell><cell>46.00</cell></row><row><cell>-v2</cell><cell>86.46</cell><cell cols=\"9\">68.19 89.98 77.59 59.42 81.04 68.57 53.85 82.19 65.07</cell><cell>46.50</cell></row><row><cell>-v3</cell><cell>98.10</cell><cell cols=\"9\">76.84 88.08 82.07 68.22 80.20 73.72 68.84 80.45 74.19</cell><cell>53.00</cell></row><row><cell>Llama-3.1-8B-I*</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row><row><cell>-v1</cell><cell>99.18</cell><cell cols=\"9\">60.25 93.00 73.13 51.60 83.57 63.81 55.06 85.69 67.04</cell><cell>57.50</cell></row><row><cell>-v2</cell><cell>96.81</cell><cell cols=\"9\">94.56 91.26 92.88 85.03 82.16 83.57 84.21 83.94 84.08</cell><cell>57.00</cell></row><row><cell>-v3</cell><cell>99.20</cell><cell cols=\"9\">93.10 92.21 92.65 83.85 83.15 83.50 85.03 84.90 84.96</cell><cell>55.00</cell></row></table></figure>\n\t\t\t<note xmlns=\"http://www.tei-c.org/ns/1.0\" place=\"foot\" n=\"1\" xml:id=\"foot_0\"><p>https://github.com</p></note>\n\t\t\t<note xmlns=\"http://www.tei-c.org/ns/1.0\" place=\"foot\" n=\"7\" xml:id=\"foot_1\"><p>https://pubchem.ncbi.nlm.nih.gov</p></note>\n\t\t\t<note xmlns=\"http://www.tei-c.org/ns/1.0\" place=\"foot\" n=\"8\" xml:id=\"foot_2\"><p>https://huggingface.co/AI4Chem/ ChemLLM-20B-Chat-DPO</p></note>\n\t\t\t<note xmlns=\"http://www.tei-c.org/ns/1.0\" place=\"foot\" n=\"9\" xml:id=\"foot_3\"><p>https://huggingface.co/sentence-transformers/ all-MiniLM-L6-v2</p></note>\n\t\t\t<note xmlns=\"http://www.tei-c.org/ns/1.0\" place=\"foot\" n=\"10\" xml:id=\"foot_4\"><p>https://huggingface.co/nvidia/NV-Embed-v2</p></note>\n\t\t\t<note xmlns=\"http://www.tei-c.org/ns/1.0\" place=\"foot\" xml:id=\"foot_5\"><p>Table 6: Single-Calling Results</p></note>\n\t\t</body>\n\t\t<back>\n\n\t\t\t<div type=\"availability\">\n<div xmlns=\"http://www.tei-c.org/ns/1.0\"><p><ref type=\"url\" target=\"https://github.com/ur-whitelab/chemcrow-public\">https://github.com/ur-whitelab/chemcrow-public</ref>  <ref type=\"url\" target=\"https://github.com/ur-whitelab/chemcrow-runs\">https://github.com/ur-whitelab/chemcrow-runs</ref> 3 CACTUS: <ref type=\"url\" target=\"https://github.com/pnnl/cactus\">https://github.com/pnnl/cactus</ref> 4 chemlib: <ref type=\"url\" target=\"https://github.com/harirakul/chemlib\">https://github.com/harirakul/chemlib</ref> 5 pymatgen: <ref type=\"url\" target=\"https://github.com/materialsproject/pymatgen\">https://github.com/materialsproject/pymatgen</ref> 6 Chemistry Tools: <ref type=\"url\" target=\"https://github.com/domdfcoding/chemistry_tools\">https://github.com/domdfcoding/chemistry_tools</ref> </p></div>\n\t\t\t</div>\n\n\t\t\t<div type=\"annex\">\n<div xmlns=\"http://www.tei-c.org/ns/1.0\"><head>A More Experimental Details</head><p>A.1 HE-MCTS Model Settings</p></div>\n<div xmlns=\"http://www.tei-c.org/ns/1.0\"><head>Model</head></div>\n<div xmlns=\"http://www.tei-c.org/ns/1.0\"><head>Policy Model Execution Model PRM ORM</head><p>GPT-4o-mini-M / / / gpt-4o Claude-3.5-S-M / / / Claude-3.5-S Qwen-2.5-7B-M1 </p><formula xml:id=\"formula_15\">D p D u D p gpt-4o Qwen-2.5-7B-M2 Dp ∪ D p D u Dp ∪ D p gpt-4o Qwen-2.5-7B-M3 Dp ∪ D p D u D P RM D ORM Llama-3.1-8B-M0 / D u / gpt-4o Llama-3.1-8B-M1 D p D u D p gpt-4o Llama-3.1-8B-M2 Dp ∪ D p D u Dp ∪ D p gpt-4o Llama-3.1-8B-M3 Dp ∪ D p D u D P RM D ORM</formula></div><figure xmlns=\"http://www.tei-c.org/ns/1.0\" type=\"table\" xml:id=\"tab_4\"><head>Table 5 :</head><label>5</label><figDesc>Training dataset for Different Models</figDesc><table><row><cell cols=\"3\">A.2 Results of Single-Calling Dataset</cell><cell></cell><cell></cell><cell></cell><cell></cell></row><row><cell>Model</cell><cell>Format</cell><cell>Tool ACC</cell><cell>P</cell><cell>Param R</cell><cell>F1</cell><cell cols=\"2\">Return Pass Rate ACC</cell></row><row><cell>GPT-4o-mini</cell><cell cols=\"6\">100.00 93.20 96.24 94.74 95.48 90.71</cell><cell>86.88</cell></row><row><cell>Claude-3.5-S</cell><cell>98.08</cell><cell cols=\"5\">92.34 97.24 95.08 96.15 90.52</cell><cell>80.27</cell></row><row><cell>ChemLLM-1*</cell><cell>93.97</cell><cell cols=\"5\">88.31 97.06 89.02 92.86 88.12</cell><cell>70.98</cell></row><row><cell>Qwen-2.5-7B-I</cell><cell>64.08</cell><cell cols=\"5\">56.70 91.15 61.79 73.65 54.50</cell><cell>49.23</cell></row><row><cell>Llama-2-7B-C</c