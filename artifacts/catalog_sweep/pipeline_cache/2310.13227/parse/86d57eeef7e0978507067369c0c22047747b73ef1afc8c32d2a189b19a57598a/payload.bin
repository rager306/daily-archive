(&apos;A5 worksheet.clear() set_with_dataframe(worksheet, df, include_index=False, include_column_header=True</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b61\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">VIRTUAL HOME Below, we present five examples of API documents from the Virtual Home dataset: &lt;ToolChain * VirtualHome Doc&gt; Prompt # Take a piece of clothes off. &apos;object&apos; can only be: [&apos;clothes_jacket&apos;, &apos;clothes_dress</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b62\">\n\t<analytic>\n\t\t<title/>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Agent.TakeOff(object)</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b63\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">&apos;object&apos; can only be: [&apos;mop&apos;, &apos;cup&apos;, &apos;toilet&apos;, &apos;plate&apos;, &apos;soap&apos;, &apos;sink&apos;, &apos;spoon</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">An</forename><surname>Scrub</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Object</surname></persName>\n\t\t</author>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b64\">\n\t<analytic>\n\t\t<title/>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Agent.Scrub(object)</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b65\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">&apos;object&apos; can only be: [&apos;cup&apos;, &apos;pot&apos;, &apos;water&apos;, &apos;water_glass&apos;, &apos;sponge&apos;, &apos;soap&apos;, &apos;towel&apos;, &apos;dish_soap&apos;, &apos;oven&apos;, &apos;cleaning_solution&apos;, &apos;knife&apos;, &apos;spoon&apos;, &apos;sink</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">An</forename><surname>Rinse</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persNa