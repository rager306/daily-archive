 Russian Hindi Italian Portuguese Spanish Chinese</cell></row><row><cell>o1-preview</cell><cell>0.783</cell><cell>0.834</cell><cell>0.820</cell><cell>0.633</cell><cell>0.775</cell><cell>0.819</cell><cell>0.811</cell><cell>0.804</cell><cell>0.766</cell></row><row><cell>o1-mini</cell><cell>0.772</cell><cell>0.802</cell><cell>0.800</cell><cell>0.684</cell><cell>0.763</cell><cell>0.812</cell><cell>0.782</cell><cell>0.809</cell><cell>0.728</cell></row><row><cell>GPT-4o</cell><cell>0.724</cell><cell>0.784</cell><cell>0.745</cell><cell>0.601</cell><cell>0.708</cell><cell>0.760</cell><cell>0.740</cell><cell>0.749</cell><cell>0.705</cell></row><row><cell>GPT-4</cell><cell>0.705</cell><cell>0.756</cell><cell>0.752</cell><cell>0.619</cell><cell>0.634</cell><cell>0.731</cell><cell>0.734</cell><cell>0.729</cell><cell>0.685</cell></row><row><cell>Llama 3.1 405B</cell><cell>0.782</cell><cell>0.843</cell><cell>0.822</cell><cell>0.692</cell><cell>0.754</cell><cell>0.793</cell><cell>0.801</cell><cell>0.800</cell><cell>0.748</cell></row><row><cell>Llama 3.1 70B</cell><cell>0.742</cell><cell>0.814</cell><cell>0.774</cell><cell>0.629</cell><cell>0.707</cell><cell>0.781</cell><cell>0.778</cell><cell>0.757</cell><cell>0.697</cell></row><row><cell>Llama 3.1 8B</cell><cell>0.615</cell><cell>0.720</cell><cell>0.663</cell><cell>0.472</cell><cell>0.540</cell><cell>0.631</cell><cell>0.645</cell><cell>0.678</cell><cell>0.570</cell></row><row><cell>Gemini-1.5 pro</cell><cell>0.624</cell><cell>0.710</cell><cell>0.646</cell><cell>0.565</cell><cell>0.578</cell><cell>0.625</cell><cell>0.610</cell><cell>0.641</cell><cell>0.613</cell></row><row><cell>Gemini-1.5 flash</cell><cell>0.570</cell><cell>0.644</cell><cell>0.602</cell><cell>0.420</cell><cell>0.534</cell><cell>0.628</cell><cell>0.571</cell><cell>0.574</cell><cell>0.591</cell></row><row><cell>Claude-3.5 Sonnet</cell><cell>0.705</cell><cell>0.780</cell><cell>0.724</cell><cell>0.632</cell><cell>0.679</cell><cell>0.705</cell><cell>0.707</cell><cell>