persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Diogo</forename><surname>Almeida</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Janko</forename><surname>Altenschmidt</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Sam</forename><surname>Altman</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2303.08774</idno>\n\t\t<title level=\"m\">Shyamal Anadkat, et al. Gpt-4 technical report</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2023\">2023</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b1\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">The claude 3 model family: Opus, sonnet</title>\n\t\t<author>\n\t\t\t<persName><surname>Anthropic</surname></persName>\n\t\t</author>\n\t\t<ptr target=\"https://api.semanticscholar.org/CorpusID\" />\n\t\t<imprint>\n\t\t\t<biblScope unit=\"page\">268232499</biblScope>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b2\">\n\t<monogr>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Damian</forename><surname>Blasi</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Antonios</forename><surname>Anastasopoulos</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Graham</forename><surname>Neubig</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2110.06733</idno>\n\t\t<title level=\"m\">Systematic inequalities in language technology performance across the world&apos;s languages</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2021\">2021</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b3\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"ma