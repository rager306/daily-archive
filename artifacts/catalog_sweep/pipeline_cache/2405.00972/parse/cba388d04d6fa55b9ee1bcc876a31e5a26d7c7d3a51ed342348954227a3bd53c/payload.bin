3</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b4\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Large language models as tool makers</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Tianle</forename><surname>Cai</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Xuezhi</forename><surname>Wang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Tengyu</forename><surname>Ma</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Xinyun</forename><surname>Chen</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Denny</forename><surname>Zhou</surname></persName>\n\t\t</author>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">5</biblScope>\n\t\t\t<biblScope unit=\"page\">2023</biblScope>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b5\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">TALM: Tool Augmented Language Models</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Aaron</forename><surname>Parisi</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Yao</forename><surname>Zhao</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Noah</forename><surname>Fiedel</surname></persName>\n\t\t</author>\n\t\t<ptr target=\"http://arxiv.org/abs/2205.12255\" />\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2022-05\">may 2022</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b6\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Large language models cannot self-correct reasoning yet</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jie</forename><surname>Huang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\"