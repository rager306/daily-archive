id":"b79","section_path_id":"2.2","quote":"Zakka et al., 2022)","offset":782}]},{"raw_text":"Adaptigraph: Material-adaptive graph-based neural dynamics for robotic manipulation\n\t\t\n\t\t\tKaifengZhang\n\t\t\n\t\t\n\t\t\tBaoyuLi\n\t\t\n\t\t\n\t\t\tKrisHauser\n\t\t\n\t\t\n\t\t\tYunzhuLi\n\t\t\n\t\tarXiv:2407.07889\n\t\t\n\t\t\t2024\n\t\t\n\t\n\tarXiv preprint","doi":null,"arxiv_id":"2407.07889","title":null,"anchors":[{"ref_id":"b80","section_path_id":"2.2","quote":"(Zhang et al., 2024;","offset":1115}]},{"raw_text":"Adding conditional control to text-to-image diffusion models\n\t\t\n\t\t\tLvminZhang\n\t\t\n\t\t\n\t\t\tAnyiRao\n\t\t\n\t\t\n\t\t\tManeeshAgrawala\n\t\t\n\t\n\t\n\t\tProceedings of the IEEE/CVF International Conference on Computer Vision\n\t\tthe IEEE/CVF International Conference on Computer Vision\n\t\t\n\t\t\t2023","doi":null,"arxiv_id":null,"title":"Adding conditional control to text-to-image diffusion models","anchors":[{"ref_id":"b81","section_path_id":"1~4","quote":"(Zhang et al., 2023;","offset":1084}]},{"raw_text":"SiyuanZhou\n\t\t\n\t\t\n\t\t\tYilunDu\n\t\t\n\t\t\n\t\t\tJiabenChen\n\t\t\n\t\t\n\t\t\tYandongLi\n\t\t\n\t\t\n\t\t\tDit-YanYeung\n\t\t\n\t\t\n\t\t\tChuangGan\n\t\t\n\t\t\n\t\t\tRobodreamer\n\t\t\n\t\tarXiv:2404.12377\n\t\tLearning compositional world models for robot imagination\n\t\t\n\t\t\t2024\n\t\t\n\t\n\tarXiv preprint","doi":null,"arxiv_id":"2404.12377","title":null,"anchors":[{"ref_id":"b82","section_path_id":"1","quote":"Zhou et al. (2024)","offset":1696}]},{"raw_text":"FangqiZhu\n\t\t\n\t\t\n\t\t\tHongtaoWu\n\t\t\n\t\t\n\t\t\tSongGuo\n\t\t\n\t\t\n\t\t\tYuxiaoLiu\n\t\t\n\t\t\n\t\t\tChilamCheang\n\t\t\n\t\t\n\t\t\tTaoKong\n\t\t\n\t\t\n\t\t\tIrasim\n\t\t\n\t\tarXiv:2406.14540\n\t\tLearning interactive real-robot action simulators\n\t\t\n\t\t\t2024\n\t\t\n\t\n\tarXiv preprint","doi":null,"arxiv_id":"2406.14540","title":null,"anchors":[{"ref_id":"b83","section_path_id":"1","quote":"Zhu et al., 2024;","offset":5270},{"ref_id":"b83","section_path_id":"2.1","quote":"Zhu et al., 2024;","offset":860},{"ref_id":"b83","section_path_id":"2.2","quote":"Zhu et al., 2024;","offset":555},{"ref_id":"b83","section_path_id":"1~4","quote":"Zhu et al., 2024)","offset":295},{"ref_id":"b83","section_path_id":"1~4","quote":"(Zhu et al., 2024)","offset":564},{"ref_id":"b83","section_path_id":"5.1","quote":"Zhu et al., 2024)","offset":1125},{"ref_id":"b83","section_path_id":"5.2","quote":"(Zhu et al., 2024)","offset":544},{"ref_id":"b83","section_path_id":"1~6","quote":"(Zhu et al., 2024)","offset":453},{"ref_id":"b83","section_path_id":"1~10","quote":"Zhu et al., 2024)","offset":177}]}],"layout_json":null,"tei_xml":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<TEI xml:space=\"preserve\" xmlns=\"http://www.tei-c.org/ns/1.0\" \nxmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \nxsi:schemaLocation=\"http://www.tei-c.org/ns/1.0 https://raw.githubusercontent.com/kermitt2/grobid/master/grobid-home/schemas/xsd/Grobid.xsd\"\n xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\t<teiHeader xml:lang=\"en\">\n\t\t<fileDesc>\n\t\t\t<titleStmt>\n\t\t\t\t<title level=\"a\" type=\"main\">FLIP: FLOW-CENTRIC GENERATIVE PLANNING AS GENERAL-PURPOSE MANIPULATION WORLD MODEL</title>\n\t\t\t</titleStmt>\n\t\t\t<publicationStmt>\n\t\t\t\t<publisher/>\n\t\t\t\t<availability  status=\"unknown\">\n\t\t\t\t\t<licence/>\n\t\t\t\t</availability>\n\t\t\t\t<date type=\"published\" when=\"2025-02-16\">16 Feb 2025</date>\n\t\t\t</publicationStmt>\n\t\t\t<sourceDesc>\n\t\t\t\t<biblStruct status=\"extracted\">\n\t\t\t\t\t<analytic>\n\t\t\t\t\t\t<author>\n\t\t\t\t\t\t\t<persName><forename type=\"first\">Chongkai</forename><surname>Gao</surname></persName>\n\t\t\t\t\t\t\t<email>gaochongkai@u.nus.edu</email>\n\t\t\t\t\t\t\t<affiliation key=\"aff0\">\n\t\t\t\t\t\t\t\t<orgName type=\"institution\" key=\"instit1\">National University of Singapore</orgName>\n\t\t\t\t\t\t\t\t<orgName type=\"institution\" key=\"instit2\">Peking University</orgName>\n\t