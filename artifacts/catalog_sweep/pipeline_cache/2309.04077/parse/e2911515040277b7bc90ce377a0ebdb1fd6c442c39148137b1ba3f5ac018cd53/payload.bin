:null,"title":"Multi-Object Navigation Using Potential Target Position Policy Function","anchors":[{"ref_id":"b40","section_path_id":"1","quote":"Zeng et al. 2023;","offset":14119}]},{"raw_text":"WXZhao\n\t\t\n\t\tarXiv:2303.18223\n\t\tA survey of large language models\n\t\t\n\t\t\t2023","doi":null,"arxiv_id":"2303.18223","title":null,"anchors":[{"ref_id":"b41","section_path_id":"1","quote":"(Zhao et al. 2023;","offset":9928}]},{"raw_text":"Target-driven visual navigation in indoor scenes using deep reinforcement learning\n\t\t\n\t\t\tYZhu\n\t\t\n\t\t\n\t\t\t2017\n\t\t\n\t\n\tIn ICRA","doi":null,"arxiv_id":null,"title":null,"anchors":[{"ref_id":"b42","section_path_id":"1","quote":"(Zhu et al. 2017)","offset":8484}]}],"layout_json":null,"tei_xml":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<TEI xml:space=\"preserve\" xmlns=\"http://www.tei-c.org/ns/1.0\" \nxmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \nxsi:schemaLocation=\"http://www.tei-c.org/ns/1.0 https://raw.githubusercontent.com/kermitt2/grobid/master/grobid-home/schemas/xsd/Grobid.xsd\"\n xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\t<teiHeader xml:lang=\"en\">\n\t\t<fileDesc>\n\t\t\t<titleStmt>\n\t\t\t\t<title level=\"a\" type=\"main\">SayNav: Grounding Large Language Models for Dynamic Planning to Navigation in New Environments</title>\n\t\t\t\t<funder ref=\"#_q7rmp8M\">\n\t\t\t\t\t<orgName type=\"full\">Defense Advanced Research Projects Agency</orgName>\n\t\t\t\t\t<orgName type=\"abbreviated\">DARPA</orgName>\n\t\t\t\t</funder>\n\t\t\t</titleStmt>\n\t\t\t<publicationStmt>\n\t\t\t\t<publisher/>\n\t\t\t\t<availability  status=\"unknown\">\n\t\t\t\t\t<licence/>\n\t\t\t\t</availability>\n\t\t\t\t<date type=\"published\" when=\"2024-04-03\">3 Apr 2024</date>\n\t\t\t</publicationStmt>\n\t\t\t<sourceDesc>\n\t\t\t\t<biblStruct status=\"extracted\">\n\t\t\t\t\t<analytic>\n\t\t\t\t\t\t<author>\n\t\t\t\t\t\t\t<persName><forename type=\"first\">Abhinav</forename><surname>Rajvanshi</surname></persName>\n\