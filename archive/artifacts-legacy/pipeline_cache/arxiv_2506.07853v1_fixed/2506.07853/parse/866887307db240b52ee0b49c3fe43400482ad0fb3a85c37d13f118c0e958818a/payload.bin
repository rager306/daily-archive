ype=\"first\">Fabio</forename><surname>Grandi</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Rafik</forename><surname>Bouaziz</surname></persName>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.1007/s13740-016-0066-3</idno>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Journal on Data Semantics</title>\n\t\t<title level=\"j\" type=\"abbrev\">J Data Semant</title>\n\t\t<idno type=\"ISSN\">1861-2032</idno>\n\t\t<idno type=\"ISSNe\">1861-2040</idno>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">5</biblScope>\n\t\t\t<biblScope unit=\"issue\">3</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"141\" to=\"163\" />\n\t\t\t<date type=\"published\" when=\"2016-06-10\">2016</date>\n\t\t\t<publisher>Springer Science and Business Media LLC</publisher>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"consolidated\" source=\"crossref\" xml:id=\"b9\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Leveraging Knowledge Graphs and LLMs to Support and Monitor Legislative Systems</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Andrea</forename><surname>Colombo</surname></persName>\n\t\t\t<idno type=\"ORCID\">0000-0002-7596-8863</idno>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.1145/3627673.3680268</idno>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">Proceedings of the 33rd ACM International Conference on Information and Knowledge Management</title>\n\t\t<meeting>the 33rd ACM International Conference on Information and Knowledge Management</meeting>\n\t\t<imprint>\n\t\t\t<publisher>ACM</publisher>\n\t\t\t<date type=\"published\" when=\"2024-10-21\">2024</date>\n\t\t\t<biblScope unit=\"page\" from=\"5443\" to=\"5446\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n\t\t\t\t</listBibl>\n\t\t\t</div>\n\t\t</back>\n\t</text>\n</TEI>\n","pdf_hash":"bd601ac01957bfcb5ccaae523ecf11d324d21e2a6bb59ea8a094f1e6a1a8e906"}