n"},{"source_component":"Scoring & Reflection","relation":"selects","target_component":"Better Candidate"},{"source_component":"Add","relation":"adds to","target_component":"Better Candidate"}],"findings":["Inference routes each input through a Router to a Target Model and then produces an Output.","The co-evolution area separates Router Evolution from Prompt Evolution.","Router evolution uses sampled training data and a learning loop to produce an Updated Router.","Grouped Training Data feeds prompt evolution, where the Prompt Set is updated through another learning loop.","The Learning Loop contains mutation, scoring and reflection, and addition of better candidates."],"citations":[{"section_id":"sec-1~10","path_id":"1~10","quote":"Inference routes each input to a specialized prompt; learning co-evolves the router and prompt set through mutation, analysis, reflection, scoring, and regrouping."}],"confidence":0.96,"provenance":{"image_sha256":"147d59a7c38b0d9dfe82c3563172ed27c3006d26b8d646df02db7243a1822eb3","context_sha256":"22836931b61445a5b853781a5e00230e33662998e3cccf3d6d209109cd95b82d","route_id":"figure-qa-luna","protocol":"openai_chat_completions","requested_model":"cx/gpt-5.6-luna","resolved_model":"cx/gpt-5.6-luna","prompt_sha256":"4786e6f3681b05b0e475e188f0fbd61e98def58906b98ae8010b07dfd44df596","output_schema_sha256":"ce01a5a23e7881cf450e76df819196e554730dbbea77c8ec1cf7e93a2dc11753","schema_id":"diagram_analysis","stage1_visual_type":"flowchart","prompt_task_sha256":"1dd7985b1567eda8d66c3da3478eab188eb6764f7e1445eb1b1014b72ad08dd6","route_policy_sha256":"897498afc82f7598dc9ebd6687dba16a821e18722262df3e299e45136eed1940","model_binding_sha256":"01208a249b295331443fdc61a0e35c1fe80cfdaea164f7a8d95c94b82517f43c","input_sha256":"08f6b35c35cbd8ca75a1bbebd14da34f3530c01aa9b2e8b14ca19e9eb8c51eae","output_sha256":"3ffb98954c382a3dd0c5f1c0cac07bfab8bbb76e8624f762cd66c2d19672aafd","input_tokens":2518,"output_tokens":965,"latency_ms":18590},"typed_payload":null,"auth