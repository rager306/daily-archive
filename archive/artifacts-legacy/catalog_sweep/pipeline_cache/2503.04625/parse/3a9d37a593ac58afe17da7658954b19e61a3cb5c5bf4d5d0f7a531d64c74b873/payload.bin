l,"representation":{"plain_text":"1. (x -y)(1 + z) = 0 2. (y -z)(1 + x) = 0"},"span":{"start":2514,"end":2555},"source_digest":"b8cda5557fcbd5d7d4655d9dfdada03d6e8b668a2c0a841580d24e4073695979","missingness":null},{"formula_id":"formula_4","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"(x -y)(1 + z) &lt; 0 Substitute z: (x -y)(1 + 75 -x -y) &lt; 0 Simplify: (x -y)(76 -x -y) &lt; 0 Second inequality: (y -z)(1 + x) &lt; 0 Substitute z: (y -(75 -x -y))(1 + x) &lt; 0 Simplify: (y -75 + x + y)(1 + x) &lt; 0"},"span":{"start":3069,"end":3289},"source_digest":"0c470b250e948271a9736c65cad0f9d21d05cfd572672c48350fa2fdc27f3cc3","missingness":null},{"formula_id":"formula_5","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"(x + 2y -75)(1 + x) &lt; 0"},"span":{"start":3308,"end":3334},"source_digest":"a44c0e9a6ab804b902ae8717f981ffca6d03d971476eace6e0e847dab60fb481","missingness":null},{"formula_id":"formula_6","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"1. (x -y)(76 -x -y) &lt; 0 2. (x + 2y -75)(1 + x) &lt; 0"},"span":{"start":3383,"end":3439},"source_digest":"3d6e6074ae52ff84c4e9d6a4dde3a398271bced203e05d693023250dcaf4fd91","missingness":null},{"formula_id":"formula_7","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"# Inequalities ineq1 = x -y*z &lt; y -z*x ineq2 = y -z*x &lt; z -x*y # Solve plane equation for z z_expr = sp.solve(plane_eq, z)[0] # Substitute z in inequalities ineq1_sub = ineq1.subs(z, z_expr) ineq2_sub = ineq2.subs(z, z_expr) # Simplify inequalities ineq1_simplified = sp.simplify(ineq1_sub) ineq2_simplified = sp.simplify(ineq2_sub) print((ineq1_simplified, ineq2_simplified))"},"span":{"start":3680,"end":4062},"source_digest":"893ce066cd15a1399fb64b06579c69352edfe686688725584ff40478e73673fd","missingness":null},{"formula_id":"formula_8","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"Area = 1 2 ∥ --→ BC × --→ BF ∥"},"span":{"start":4310,"end":4340},"source_digest":"abd040705436e89499a8f8e6f650ba4916ddd3168d65a4ee36b25ec215a7396c","missingness":null},{"formula_id":"formula_9","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (x) + f (y) = f (x + y) -xy -1"},"span":{"start":4702,"end":4734},"source_digest":"16f9873dd3ddea70eaad5980fcfb8ce4e367ba657422034d66d1620c5d242dbb","missingness":null},{"formula_id":"formula_10","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (x) + f (0) = f (x + 0) -x • 0 -1 Which simplifies to: f (x) + f (0) = f (x) -0 -1 So: f (0) = -1"},"span":{"start":5311,"end":5410},"source_digest":"4bc08d4d74c96add6bf83cd4590af41bf235c7937aa2458c5252709f86203628","missingness":null},{"formula_id":"formula_11","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (x) + f (1) = f (x + 1) -x • 1 -1 Substituting f (1) = 1: f (x) + 1 = f (x + 1) -x -1"},"span":{"start":5517,"end":5604},"source_digest":"f15daed1ab7afdb83afba0d79ac78b89cdc6951e72ac5257ce30db9b15820f7d","missingness":null},{"formula_id":"formula_12","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (x + 1) = f (x) + 1 + x + 1 = f (x) + x + 2"},"span":{"start":5631,"end":5676},"source_digest":"23f2f155d6d675e2e7a6a85ef46452b66a31a624e41a60170a49077903dccf41","missingness":null},{"formula_id":"formula_13","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (x + 1) = f (x) + x + 2."},"span":{"start":5708,"end":5734},"source_digest":"6b4f70b3e0de7db425e4a01e9044b325374c419e7aedf7eb9a25cd2ecd435474","missingness":null},{"formula_id":"formula_14","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (2) = f (1) + 1 + 2 = 1 + 1 + 2 = 4 Now x = 2: f (3) = f (2) + 2 + 2 = 4 + 2 + 2 = 8"},"span":{"start":5905,"end":5991},"source_digest":"7a34d4de7f81ea8fc158297c04d390e2aa120b6bab4cd6c5506b809df9f5e819","missingness":null},{"formula_id":"formula_15","section_path_id":"1~9","section_ordinal":21,"label":"So","coordinates":null,"representation":{"plain_text":"f (x) + f (y) = f (x + y) -xy -1So"},"span":{"start":6686,"end":6720},"source_digest":"e33d59ae3520f94bf738c45067fcc777243a842476a7ba237ac8a0646c1d57a9","missingness":null},{"formula_id":"formula_16","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"a = 1 2 , b = b, c = -1"},"span":{"start":7184,"end":7207},"source_digest":"3f299f142754cb09737fc9187c9d94675d8e336c1877dde7b569dba360527fab","missingness":null},{"formula_id":"formula_17","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (1) = 1 2 (1) 2 + b(1) -1 = 1 2 + b -1 = b - 1 2 = 1 So: b - 1 2 = 1 =⇒ b = 1 + 1 2 = 3 2 Therefore, the function is: f (x) = 1 2 x 2 + 3 2 x -1"},"span":{"start":7475,"end":7621},"source_digest":"94433d95ce169e4493d95dded6253e289ef300117a12ee5c9ccdc2c32edcb727","missingness":null},{"formula_id":"formula_18","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (x) + f (y) = 1 2 x 2 + 3 2 x -1 + 1 2 y 2 + 3 2 y -1 = 1 2 x 2 + 1 2 y 2 + 3 2 x + 3 2 y -2"},"span":{"start":7792,"end":7886},"source_digest":"c9c62dd47569ad468565456700918a51f88512df57a786aad1d22667dbf7ca9f","missingness":null},{"formula_id":"formula_19","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"f (x + y) -xy -1 = 1 2 (x + y) 2 + 3 2 (x + y) -1 -xy -1 Expand f (x + y): 1 2 (x 2 + 2xy + y 2 ) + 3 2 x + 3 2 y -1 = 1 2 x 2 + xy + 1 2 y 2 + 3 2 x + 3 2 y -1"},"span":{"start":7909,"end":8069},"source_digest":"1cdbaf8796578a18db76e508d4d50fec18f3a8783bc57a95fc93c5cda9919bab","missingness":null},{"formula_id":"formula_20","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"1 2 n 2 + 3 2 n -1 = n"},"span":{"start":8179,"end":8201},"source_digest":"b1df55e7ac140347d6f18862f2f7035db6d465e466f655891e2cf756f24f29d8","missingness":null},{"formula_id":"formula_21","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"1 2 n 2 + 3 2 n -1 -n = 0"},"span":{"start":8228,"end":8253},"source_digest":"f1eb5ffd66e60a34d8647e51bef7228d13725d12541b3ed53321a7f756dca13c","missingness":null},{"formula_id":"formula_22","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"1 2 n 2 + 3 2 -1 n -1 = 0 1 2 n 2 + 1 2 n -1 = 0"},"span":{"start":8262,"end":8310},"source_digest":"bb8f36273db60b050d34d167b20ef6de4bb933a8c1e8525c0ec396690272cf9c","missingness":null},{"formula_id":"formula_23","section_path_id":"1~9","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"n 2 + n -2 = 0 Now, solve for n: n = -1 ± √ 1 + 8 2 = -1 ± 3 2 So, two solutions: n = -1 + 3 2 = 1 n = -1 -3 2 = -2"},"span":{"start":8358,"end":8473},"source_digest":"d30499f584632b0026d5569f4b799e90fe88da373ad277b77ee5a129a5a798c9","missingness":null},{"formula_id":"formula_24","section_path_id":"1~10","section_ordinal":22,"label":null,"coordinates":null,"representation":{"plain_text":"L = 4πR 2 σT 4 eff"},"span":{"start":1297,"end":1315},"source_digest":"f9d921a10d86a516e90bba23f7c8e7512e960f9ea10e5e3e7ba7a762ece43b0c","missingness":null},{"formula_id":"formula_25","section_path_id":"1~10","section_ordinal":22,"label":null,"coordinates":null,"representation":{"plain_text":"N 2 N 1 = g 2 g 1 exp - ∆E kT Where:"},"span":{"start":1873,"end":1909},"source_digest":"9a0f75eac3011555