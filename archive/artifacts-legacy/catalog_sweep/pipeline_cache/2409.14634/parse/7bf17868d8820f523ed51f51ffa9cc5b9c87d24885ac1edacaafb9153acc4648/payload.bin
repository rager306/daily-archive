r>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Kiyoshi</forename><surname>Izumi</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Hiroki</forename><surname>Sakaji</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2406.10811</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024. 2024</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b65\">\n\t<monogr>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Qingyun</forename><surname>Wang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Doug</forename><surname>Downey</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Ji</forename><surname>Heng</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Tom</forename><surname>Hope</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2305.14259</idno>\n\t\t<title level=\"m\">Scimon: Scientific inspiration machines optimized for novelty</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2023\">2023. 2023</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b66\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Creative Computing: an approach to knowledge combination for creativity?</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Hongji</forename><surname>Yang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Delin</forename><surname>Jing</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Lu</forename><surname>Zhang</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">2016 IEEE Symposium on Service-Oriented System Engineering (SOSE)</title>\n\t\t<imprint>\n\t\t\t<publisher>IEEE</publisher>\n\t\t\t<date type=\"published\" when=\"2016\">2016</date>\n\t\t\t<biblScope unit=\"page\" from=\"407\" to=\"414\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b67\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Self-alignment for factuality: Mitigating hallucinations in llms via self-evaluation</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Xiaoying</forename><surname>Zhang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Baolin</forename><surname>Peng</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Ye</forename><surname>Tian</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jingyan</forename><surname>Zhou</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Lifeng</forename><surname>Jin</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Linfeng</forename><surname>Song</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Haitao</forename><surname>Mi</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Helen</forename><surname>Meng</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2402.09267</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024. 2024</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b68\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Input: The idea text + 𝑘 top-ranked similar papers from the retrieval pipeline. Task: Write a 60-100 word review comparing the idea to the retrieved papers, then classify as Novel or Not Novel. Novelty definitions: Not Novel-closely replicates existing work with minimal new contributions. Novel-introduces new concepts/approaches not common in literature; or uniquely combines existing concepts in a way no retrieved paper does; or applies the same approach to a genuinely new domain. In-context learning: Expert-labeled (idea, papers, review, classification) tuples are injected-the same examples shown in Appendix C.2. Multi-turn structure: Uses a simulated dialogue (user → assistant → user) to first present the idea</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>3.4 Assess Idea Novelty. noveltyChecker(idea, similar_papers, expert_examples) Role: ReviewerGPT (system message then inject each retrieved paper as a separate user message-ensuring the model attends to each paper individually. Output: Class: [novel / not novel] followed by Review: The idea is [novel / not novel] because..</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b69\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Input: The original idea (short + long versions), the prior work it overlaps with, the novelty review explaining why it is not novel, and the full set of available facets in the user&apos;s workspace. Task: Generate 3 alternative ideas, each created by swapping exactly one facet: (1) Remove one purpose</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>Generate More-Novel Idea Suggestions. moreNovelIdea(idea, overlapping_papers, available_facets) Trigger: Called when the novelty checker classifies an idea as &quot;Not Novel</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b70\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Remove one mechanism, add a different mechanism</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b71\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Output per option: Removed facet (text + ID), added facet (text + ID), revised idea (100-150 words), justification of novelty, justification of usefulness. Design rationale: By constraining edits to a single facet swap, suggestions remain close to the user&apos;s original intent while systematically exploring the facet space for novelty</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>Same quality requirements as the generation prompts ( §H.2.1)</note>\n</biblStruct>\n\n\t\t\t\t</listBibl>\n\t\t\t</div>\n\t\t</back>\n\t</text>\n</TEI>\n","pdf_hash":"81c202dec4b9abff133eb0f7f085d60637996027e2d4df11dc0078f3462a10e0","tables":[{"table_id":"tab_0","section_path_id":"1~62","section_ordinal":74,"caption":"Table 1 :","coordinates":null,"cells":[{"row":0,"column":0,"colspan":1,"rowspan":1,"text":"Method","coordinates":null,"span":{"start":446,"end":452},"digest":"395b70cd143100affef40939a3de9c85b65e5cea16909de665467d28c3a19d42"},{"row":0,"column":1,"colspan":1,"rowspan":1,"text":"Accuracy","coordinates":null,"span":{"start":452,"end":460},"digest":"b9e7879db99a0163c1ee51faccf18c66ac0c6f524502454fab7255502347d1a4"},{"row":1,"column":0,"colspan":1,"rowspan":1,"text":"Complete System","coordinates":null,"span":{"start":460,"end":475},"digest":"d4a6db2cdac94d69f50711f2f481831ed3dac9e0f1fdcec159b085fe373b6f63"},{"row":1,"column":1,"colspan":1,"rowspan":1,"text":"89.66%","coordinates":null,"span":{"start":475,"end":481},"digest":"ba79f0b78eb650cdfb09b92700c384da3f86784f20f22bc614427a48eb1c3608"},{"row":2,"column":0,"colspan":1,"rowspan":1,"text":"-Relevance RankGPT","coordinates":null,"span":{"start":481,"end":499},"digest":"e080de76aeabbf14dab5bceb3aa6584b06bb55c39898d714c0bc939c16b31d60"},{"row":2,"column":1,"colspan":1,"rowspan":1,"text":"13.79%","coordinates":null,"span":{"start":499,"end":505},"digest":"42781e89428f3f15b26ff2b895f9d5d0a7fd491e7a8b6e9ad46d12bd7ff192d4"},{"row":3,"column":0,"colspan":1,"rowspan":1,"text":"-Embedding Filtering","coordinates":null,"span":{"start":505,"end":525},"digest":"30f111a08643bdcfd2a922fc847e34df570f2cc01a431047e6878c54641ffa96"},{"row":3,"column":1,"colspan":1,"rowspan":1,"text":"10.34%","coordinates":null,"span":{"start":525,"end":