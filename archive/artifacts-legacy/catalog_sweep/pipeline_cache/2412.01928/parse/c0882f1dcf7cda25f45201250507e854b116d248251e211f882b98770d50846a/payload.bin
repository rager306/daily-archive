2c9bbafabc0bb4dc5cfb3b4","missingness":null},{"formula_id":"formula_9","section_path_id":"1~3","section_ordinal":6,"label":null,"coordinates":null,"representation":{"plain_text":"V(g i,j ) = E k V(v i,j,k ) ≈ 1 n n ∑ k=1 V(v i,j,k )."},"span":{"start":412,"end":466},"source_digest":"1bdbb844932ad58299c13a2f981341599ff5fa02191028432fa9d0d3f8c3b0e6","missingness":null},{"formula_id":"formula_10","section_path_id":"4.3","section_ordinal":8,"label":null,"coordinates":null,"representation":{"plain_text":"D R = (r + , r -) r + , r -∈ {r i,j,k,l } n l=1 , V(r + ) = 1, V(r -) = 0 , D V = (v + , v -) v + , v -∈ {v i,j,k } n k=1 , v+ = ✓, v-= × ."},"span":{"start":442,"end":581},"source_digest":"52294cd51ad7e47fbdd220b2c30042b8b20f8a8c2a0fd50d0ae60aba1f2b44e9","missingness":null},{"formula_id":"formula_11","section_path_id":"1~12","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"Initial Dataset D, Models G, V, R, Branching factor n GOAL: Trained models G ′ , V ′ , R ′ 1: Initialize datasets S G , S V , S R as empty sets 2: for q ∈ D do 3: A G ← {g j = G(q)} n j=1 ▷ Generate n outputs from G 4: for each g j ∈ A G do 5: A g j V ← {v j,k = V(q, g j )} n k=1 ▷ Generate n outputs from V 6: for each v j,k ∈ A g j V do 7: A g j ,v j,k R ← {r j,k,l = R(q, g j , v j,k )} n l=1 ▷ Generate n outputs from R 8: for each r j,k,l ∈ A g j ,v j,k R do 9: Compute V (r j,k,l ) = R(r j,k,l , a GT ) ▷ Reward for R output 10: Add (q, g j , v j,k , r j,k,l , V (r j,k,l )) to S R 11: end for 12: Compute V (v j,k ) = 1 n ∑ n l=1 V (r j,k,l ) ▷ Value V for V output 13: Binarize vj,k = I[V (v j,k ) &gt; 0.5] 14: Add (q, g j , v j,k , vj,k ) to S V 15: end for 16: Compute V (g j ) = 1 n ∑ n k=1 V (v j,k ) ▷ Value V for G output 17: Binarize ĝj = I[V (g j ) &gt; 0.5] 18: Add (q, g j , ĝj ) to S G 19:"},"span":{"start":8,"end":918},"source_digest":"591843e5449f2b685f9fa4098d1e7b0f2c1b9042daabdf463ac6c2e204ff45fb","missingness":null},{"formula_id":"formula_12","section_path_id":"1~12","section_ordinal":21,"label":null,"coordinates":null,"representation":{"plain_text":"22: G ′ ← SFT(G, S G ) ▷ Fine-tune G with supervised data 23: V SFT ← SFT V, (q, g j , v j,k ) | (q, g j , v j,k , vj,k ) ∈ S V , vj,k = 1 ▷ Fine-tune V on positive samples 24: V ′ ← DPO(V SFT , S V ) ▷ Train V with DPO using preferences 25: R SFT ← SFT R, (q, g j , v j,k , r j,k,l ) | V (r j,k,l ) = 1 ▷ Fine-tune R on positive samples 26: R ′ ← DPO(R SFT , S R ) ▷ Train R with DPO using preferences 27: return G ′ , V ′ , R ′"},"span":{"start":961,"end":1390},"source_digest":"ccc5d09a89b7152df3fe263625e19f174a556fd4e3870abf834c696b6d73e5ee","missingness":null},{"formula_id":"formula_13","section_path_id":"1~27","section_ordinal":36,"label":"(1)","coordinates":null,"representation":{"plain_text":"p(a w t ≻ a l t | h t ) ∝ σ Q(h t , a w t ) -Q(h t , a l t ) ,(1)"},"span":{"start":379,"end":444},"source_digest":"89ac4b664a525ead4a48780b17d958e156ec5fdeb4d700dc0cc1e02f85945243","missingness":null},{"formula_id":"formula_14","section_path_id":"1~27","section_ordinal":36,"label":"2","coordinates":null,"representation":{"plain_text":"π * (a | h t ) ∝ π ref (a | h t ) exp Q(h t , a) β , (2"},"span":{"start":742,"end":797},"source_digest":"98b740c6ebd7d44dd2028a364cd4c4ffde05eecb62acc078065ffbbfbb516655","missingness":null},{"formula_id":"formula_15","section_path_id":"1~27","section_ordinal":36,"label":null,"coordinates":null,"representation":{"plain_text":")"},"span":{"start":797,"end":798},"source_digest":"c2d6e81213f7a390f3c663698d3bfb999766cb58f914b066302eeb7aecaf061f","missingness":null},{"formula_id":"formula_16","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"J(π) = E q∼Q E g∼π G (•|s 0 ) E v∼π V (•|s 1 ) E r∼π R (•|s 2 ) R(s 2 , r) ."},"span":null,"source_digest":"668655e740477020b27da4abf52cb064777d422318112181af0e8118ff31ef0e","missingness":null},{"formula_id":"formula_17","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"(0) = (π (0) G , π (0) V , π (0) R"},"span":null,"source_digest":"3d361a8e85d11437d17ed2d0eb66db56bc638978243dcc51b1f7aaf413057a39","missingness":null},{"formula_id":"formula_18","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"Leaf nodes have V (r i,j,k,l ) = R(r i,j,k,l ) ∈ {0, 1}, veri- fier nodes compute V (v i,j,k ) = 1 n ∑ n l=1 V (r i,j,k,l ), and generator nodes estimate V (g i,j ) = 1 n 2 ∑ n k=1 ∑ n l=1 V (r i,j,k,l ). The true value V * (ν) = E π (0) [R | ν] is approximated by these Monte Carlo estimates."},"span":null,"source_digest":"9054742c38a4f5edc2733467787f3e9b7273c7f360f3f26fe303e9c899de6013","missingness":null},{"formula_id":"formula_19","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"(e.g., g with V * (g) &gt; E[V * (g)]) over π (0) G , the initial policy satisfies π (0) G (g | q) ≥ α &gt; 0, with analogous conditions for π (0) V and π (0) R ."},"span":null,"source_digest":"8509bb8261640537a0806dd5cc3d9e05193db8c53eef35dca4e5905156650015","missingness":null},{"formula_id":"formula_20","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"g i,j ), the value estimate V (ν) = 1 m ∑ m l=1 R l , where each R l ∼ Bernoulli(V * (ν)) provides an unbiased estimator of V * (ν)."},"span":null,"source_digest":"4e8c7de4d4cd1da56a80546f8f86058f615ed52e5e3f89814cce62d3d959453f","missingness":null},{"formula_id":"formula_21","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"P |V (ν) -V * (ν)| ≥ ϵ ≤ 2 exp(-2mϵ 2 )."},"span":null,"source_digest":"72d66f57b791b99a1f80e26e91fa9a39b4cdd304ce4cc4dc844df8e8de3d46da","missingness":null},{"formula_id":"formula_22","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"P |V (g i,j ) -V * (g i,j )| ≥ ϵ ≤ 2 exp(-2n 2 ϵ 2 )."},"span":null,"source_digest":"7c2b6f61b405ed7cd1c715fb406de523374c2b76bdadd4a45542dbe9760bf298","missingness":null},{"formula_id":"formula_23","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"|V (g i,j ) -V * (g i,j )| ≤ ϵ, where ϵ = ln 2Mn δ 2n 2 ."},"span":null,"source_digest":"0c18f491b0b2d9396a1b66af32489692b7c6c25fb0f6fd75037ceadf01ac0b05","missingness":null},{"formula_id":"formula_24","section_path_id":null,"section_ordinal":null,"label":null,"coordinates":null,"representation":{"plain_text":"π * (a | h t ) ∝    π ref (a | h t ) exp 1 β , if Q(h t , a) = 1, π ref (a | h t ), if Q(h t , a) = 0."},"span":null,"source_digest":"2243e8ba29257dc92ab02d9efe5d01efc33763f69ad36b1aaf44f4626c84818c","missingness":null}],"formula_missingness":null,"page_text_missingness":null}