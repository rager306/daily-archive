t<author>\n\t\t\t<persName><forename type=\"first\">Silviu</forename><surname>Cucerzan</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Sung</forename><forename type=\"middle\">Ju</forename><surname>Hwang</surname></persName>\n\t\t</author>\n\t\t<ptr target=\"https://arxiv.org/abs/2404.07738\" />\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b6\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Iclr2022-openreviewdata</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Federico</forename><surname>Berto</surname></persName>\n\t\t</author>\n\t\t<ptr target=\"https://github.com/fedebotu/ICLR2022-OpenReviewData\" />\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b7\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">The neurips 2021 consistency experiment</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Alina</forename><surname>Beygelzimer</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Yann</forename><surname>Dauphin</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Percy</forename><surname>Liang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jennifer</forename><forename type=\"middle\">Wortman</forename><surname>Vaughan</surname></persName>\n\t\t</author>\n\t\t<ptr target=\"https://blog.neurips.cc/2021/12/08/the-neurips-2021-consistency-experiment\" />\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">Neural Information Processing Systems blog post, 2021</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b8\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Quality-diversity through ai feedback</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Herbie</forename><surname>Bradley</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Andrew</forename><surname>Dai</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Benita</forename><surname>Hannah</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jenny</forename><surname>Teufel</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Koen</forename><surname>Zhang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Marco</forename><surname>Oostermeijer</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jeff</forename><surname>Bellagente</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Kenneth</forename><surname>Clune</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Gregory</forename><surname>Stanley</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Joel</forename><surname>Schott</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Lehman</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">The Twelfth International Conference on Learning Representations</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b9\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Minimal criterion coevolution: a new approach to openended search</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">C</forename><surname>Jonathan</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Kenneth</forename><forename type=\"middle\">O</forename><surname>Brant</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Stanley</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">Proceedings of the Genetic and Evolutionary Computation Conference</title>\n\t\t<meeting>the Genetic and Evolutionary Computation Conference</meeting>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2017\">2017</date>\n\t\t\t<biblScope unit=\"page\" from=\"67\" to=\"74\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b10\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Language models are few-shot learners</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">B</forename><surname>Tom</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Benjamin</forename><surname>Brown</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Nick</forename><surname>Mann</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Melanie</forename><surname>Ryder</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jared</forename><surname>Subbiah</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Prafulla</forename><surname>Kaplan</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Arvind</forename><surname>Dhariwal</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Pranav</forename><surname>Neelakantan</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Girish</forename><surname>Shyam</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Amanda</forename><surname>Sastry</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Sandhini</forename><surname>Askell</su