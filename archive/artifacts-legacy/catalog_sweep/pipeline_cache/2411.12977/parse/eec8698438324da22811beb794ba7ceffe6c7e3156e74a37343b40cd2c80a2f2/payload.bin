\">arXiv:1707.06347</idno>\n\t\t<title level=\"m\">Proximal policy optimization algorithms</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2017\">2017</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b5\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Mastering diverse domains through world models</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Danijar</forename><surname>Hafner</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jurgis</forename><surname>Pasukonis</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jimmy</forename><surname>Ba</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Timothy</forename><surname>Lillicrap</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2301.04104</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2023\">2023</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b6\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">A survey of imitation learning: Algorithms, recent developments, and challenges</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Maryam</forename><surname>Zare</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Abbas</forename><surname>Parham M Kebria</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Saeid</forename><surname>Khosravi</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Nahavandi</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">IEEE Transactions on Cybernetics</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t</imprint>\n\t</monogr>\n