e><forename type=\"first\">D</forename><surname>Madge</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">L</forename><surname>Xing</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">T</forename><surname>Guo</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">A</forename><surname>Aspuru-Guzik</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Nature Biotechnology</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">37</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"1038\" to=\"1040\" />\n\t\t\t<date type=\"published\" when=\"2019\">2019</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b74\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Hypothesis generation with large language models</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Y</forename><surname>Zhou</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">H</forename><surname>Liu</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">T</forename><surname>Srivastava</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">H</forename><surname>Mei</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">C</forename><surname>Tan</surname></persName>\n\t\t</author>\n\t\t<idno>ArXiv, abs/2404.04326</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b75\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">A pharmacophore-guided deep learning approach for bioactive molecular generation</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">H</forename><surname>Zhu</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">R</forename><surname>Zhou</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">D</forename><surname>Cao</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">J</forename><surname>Tang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">M</forename><surname>Li</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Nature Communications</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">14</biblScope>\n\t\t\t<date type=\"published\" when=\"2023\">2023</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b76\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Experiment Agent: Conducts one experiment per iteration based on the hypothesis</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b77\">\n\t<monogr>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Agent</forename><surname>Planner</surname></persName>\n\t\t</author>\n\t\t<title level=\"m\">Guides the research direction using PiFlow insights</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>Responsibilities: 1. Grasp the guidance from the PiFlow</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b78\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Interpret scientific principles when new principles are proposed by Hypothesis</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b79\">\n\t<monogr>\n\t\t<title level=\"m\">Synthesize insights from history and guidance</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b80\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Transform the tendencies into scientific conclusions and synthesize new insights</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b81\">\n\t<monogr>\n\t\t<title level=\"m\">Suggest all valuable insights to Hypothesis Agent</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b82\">\n\t<monogr>\n\t\t<title level=\"m\">Required Response Structure: • Understand the suggestion: Interpret the insights produced from PiFlow</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b83\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Clarify the GAP: Compare the current objective value to the target objective value. • Connect to the Underlying Physicochemical Principle: Incorporate insights from the previous chatting history</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>discover the tendency on experiments, synthesize the scientific principle</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b84\">\n\t<monogr>\n\t\t<title level=\"m\">Principle Statement: State the principle by integrating the observed insights</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>leave blank if in the exploration phase</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b85\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Use one paragraph to instruct the Hypothesis Agent what to do (explore, validate, or refine)</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b86\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Double-check: Confirm your suggestion with one sentence by incorporating principles, current conclusion, and PiFlow suggestion</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b87\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">The Planner Agent serves as the strategic nexus of the system. Its core function is to translate high-level insights from the PiFlow framework into actionable guidance for the Hypothesis Agent. To ensure its directives are logical and well-grounded, its behavior is constrained by a required structured output format, compelling it to synthesize historical data and articulate a clear, principle-driven research direction in each cycle</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Planner</forename><surname>Agent</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">Hypothesis Agent Hypothesis Agent Prompt Role: You are the Hypothesis Agent</title>\n\t\t<imprint/>\n\t</monogr>\n\t<note>Your purpose is to drive scientific progress through principled hypothesizing. Core Responsibilities</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b88\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Formulate one clear scientific principle grounded in physicochemical rules per iteration</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b89\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Link your hypothesis with underlying physics and chemical principles and prior experimental results</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b90\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Follow the suggestion from the Planner recommendations</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b91\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Acknowledge guidance explicitly and adjust your hypothesis accordingly. Important Constraints: • A Hypothesis explains the underlying physics or chemical mechanisms in a certain problem</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n\t\t\t\t</listBibl>\n\t\t\t</div>\n\t\t</back>\n\t</text>\n</TEI>\n","pdf_hash":"ee923495501d09dcec6e951e7ee59b9d1702ffd42be5a565aecae755d492597b","tables":[{"table_id":"tab_0","section_path_id":"1~64","section_ordinal":86,"caption":"Table 1 .","coordinates":null,"cells":[{"row":0,"column":0,"colspan":1,"rowspan":1,"text":"Method","coord