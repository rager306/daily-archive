54fe30f21194afe10a"},{"row":1,"column":0,"colspan":1,"rowspan":1,"text":"Mistral-7B, and Phi-3.8B, respectively. Greedy is our baseline result and it can be observed that","coordinates":null,"span":null,"digest":"2ae24a58467dc64c6b8945ffcb718fe3a9e664adc5b7ffa599ceba88d08f2844"},{"row":2,"column":0,"colspan":1,"rowspan":1,"text":"using the reward model leads to better experimental outcomes. Among all the results, LLaMA-70B","coordinates":null,"span":null,"digest":"2ac5a79bd7bd4f57806ea035f95ae52258ada38a681a4086d5267f0bbbeffa9b"},{"row":3,"column":0,"colspan":1,"rowspan":1,"text":"achieves the best performance. Compared to the other three models, LLaMA-70B has the largest","coordinates":null,"span":null,"digest":"3844f89f0df9320b9401aa825b3344a9fcdd209c1e6b0620e171e567a05131cd"},{"row":4,"column":0,"colspan":1,"rowspan":1,"text":"scale and is naturally the most capable model. LLaMA-8B and Mistral-7B have a similar number of","coordinates":null,"span":null,"digest":"09fecb395b0fc8413a18f700b39ae6198684b6122c8df5e3f7d545ea8235edb5"},{"row":5,"column":0,"colspan":1,"rowspan":1,"text":"parameters, and in the ScienceWorld task, Mistral-7B performs better than LLaMA-8B. Phi-3.8B","coordinates":null,"span":null,"digest":"8531c254f5d7318755fc9b34bc037deaf566a9235e26dbf5a94aa76b96ea600d"},{"row":6,"column":0,"colspan":1,"rowspan":1,"text":"is the smallest of these models, yet it still achieved very good results. Notably, compared to the","coordinates":null,"span":null,"digest":"9ae0ea8f590f2b0a1929dd5f60af5fb2fbef29df1d3e624273498789f1ade40f"},{"row":7,"column":0,"colspan":1,"rowspan":1,"text":"larger-scale LLaMA-8B and Mistral-7B, Phi-3.8B still scored better. These results indicate that","coordinates":null,"span":null,"digest":"3943f6d69bbe196ffea30e34899ee6766144b558e11cd8c7dc716807e789f928"},{"row":8,"column":0,"colspan":1,"rowspan":1,"text":"our method exhibits good robustness when faced with LLMs of different scales and capabilities.","coordinates":null,"span":null,"digest":"202e5ca58c589a90783d211e4955ee1acc25f3724410c2be3e472fd02090e179"},{"row":9,"column":0,"colspan":1,"rowspan":1,"text":"Even with the smallest model, our method can still achieve good results. From these experimental","coordinates":null,"span":null,"digest":"d2d0c72651509a46658f42c0c96100c619eacfd5ca6a182f0755a27480e875a2"}],"source_digest":"07bad457600c3ec65386656721db185b0c4fbaf0f52f6ca439fa6250e98a6856","missingness":null},{"table_id":"tab_10","section_path_id":null,"section_ordinal":null,"caption":"Table 12 :","coordinates":null,"cells":[{"row":0,"column":0,"colspan":1,"rowspan":1,"text":"GPT-4o","coordinates":null,"span":null,"digest":"f40d9d9436a3cce64185138a8c5f9be2da92c15be6835576873f96d2479d4b23"},{"row":0,"column":1,"colspan":1,"rowspan":1,"text":"Std Dev","coordinates":null,"span":null,"digest":"1f23a5ff3ec831f304f1997c8e2f6d313bfbb7d50f51cd46464f5bb1595b1c04"},{"row":1,"column":0,"colspan":1,"rowspan":1,"text":"Sampling","coordinates":null,"span":null,"digest":"dd48c3a3eaf6ff37051cbb30b9d083dafbbcc6c839a1ec6a8fa21f5d44bff4cf"},{"row":1,"column":1,"colspan":1,"rowspan":1,"text":"0.74 0.88","coordinates":null,"span":null,"digest":"74049478cca5f2680847b087019a98a9875e41415ab4c18310aa2149eea2b937"},{"row":2,"column":0,"colspan":1,"rowspan":1,"text":"Greedy","coordinates":null,"span":null,"digest":"0c206f3ec95998f246268fa685442c91594cc9b458b89bcafdfd1edf5ee366f2"},{"row":2,"column":1,"colspan":1,"rowspan":1,"text":"0.82 0.90","coordinates":null,"span":null,"digest":"2f9708eab1a6d62f6e28c7a915b9c69426b6342998c230cc5027034b2dbfffc0"},{"row":3,"column":0,"colspan":2,"rowspan":1,"text":"ARMAP-B 0.84 0.95","coordinates":null,"span":null,"digest":"5c42ac1329743d94c84580661803ee7a777dd69969e9537b07fd32bdc91d3889"}],"source_digest":"17d3ff22e615fd6ec1ae5d6ea8a97479290816ffc6e0fb42f9a3e0fa004523d1","missingness":null}],"table_missingness":null,"formulas":[{"formula_id":"formula_0","section_path_id":"3.1","section_ordinal":6,"label":"(1)","coordinates":null,"repr