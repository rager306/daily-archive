>Tom</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Benjamin</forename><surname>Brown</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Nick</forename><surname>Mann</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Melanie</forename><surname>Ryder</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jared</forename><surname>Subbiah</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Prafulla</forename><surname>Kaplan</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Dhariwal</surname></persName>\n\t\t</author>\n\t\t<ptr target=\"https://arxiv.org/abs/2005.14165\" />\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2020\">2020</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b6\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">A contemporary review on chatbots, ai-powered virtual conversational agents, chatgpt: Applications, open challenges and future research directions</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Avyay</forename><surname>Casheekar</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Archit</forename><surname>Lahiri</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Kanishk</forename><surname>Rath</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Kaushik</forename><surname>Sanjay Prabhakar</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Kathiravan</forename><surname>Srinivasan</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Computer Science Review</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">52</biblScope>\n\t\t\t<biblScope unit=\"p