nt) r y L r,ℓ ≥ D L ℓ , ∀ℓ (Light coffee demand constraint) r y D r,ℓ ≥ D D ℓ , ∀ℓ (Dark coffee demand constraint) x s,r , y L r,ℓ , y D r,ℓ ∈ Z + , ∀s, r, ℓ (Integrality constraint)"},"span":{"start":911,"end":1332},"source_digest":"7277d6431068b9e1c589fc062382d70e2c610a477fa22bcb30faa6594db6d756","missingness":null},{"formula_id":"formula_3","section_path_id":"1~11","section_ordinal":23,"label":null,"coordinates":null,"representation":{"plain_text":"O(V E) or O(V 2 E)"},"span":{"start":161,"end":179},"source_digest":"f026eb25a31fb5bcda586c87db6190f11af06525a2450884365e8431b143246c","missingness":null},{"formula_id":"formula_4","section_path_id":"1~11","section_ordinal":23,"label":null,"coordinates":null,"representation":{"plain_text":"min n i=1 m j=1 c ij d j y ij + n i=1 f i x i s.t. n i=1 y ij = 1 for all j = 1, . . . , m m j=1 d j y ij ≤ u i x i for all i = 1, . . . , n y ij ≥ 0 for all i = 1, . . . , n and j = 1, . . . , m x i ∈ {0, 1} for all i = 1, . . . , n"},"span":{"start":832,"end":1065},"source_digest":"dc3ab3721dff420ff1c2d19b071f014ee7b60fc5af5a12f468c7a7e61bef0fc9","missingness":null},{"formula_id":"formula_5","section_path_id":"1~39","section_ordinal":51,"label":null,"coordinates":null,"representation":{"plain_text":"# Problem prob = pulp.LpProblem(\"Coffee_Production\", pulp.LpMinimize) # Variables ship_supplier_to_roastery = pulp.LpVariable.dicts(\"ShipSupplierToRoastery\", [(s, r) for s in capacity_in_supplier for r in roasting_cost_light], lowBound=0, cat='Continuous') roast_light = pulp.LpVariable.dicts(\"RoastLight\", roasting_cost_light, lowBound=0, cat='Continuous') roast_dark = pulp.LpVariable.dicts(\"RoastDark\", roasting_cost_dark, lowBound=0, cat='Continuous') ship_roastery_to_cafe_light = pulp.LpVariable.dicts(\"ShipRoasteryToCafeLight\", [(r, c) for r in roasting_cost_light for c in light_coffee_needed_for_cafe], lowBound=0, cat='Continuous') ship_roastery_to_cafe_dark = pulp.LpVariable.dicts(\"ShipRoasteryToCafeDark\", [(r, c) for r in roasting_cost_dark for c in dark_coffee_needed_for_cafe], lowBound=0, cat='Continuous') # Objective prob += pulp.lpSum"},"span":{"start":1889,"end":2743},"source_digest":"3c02c5c6955342562e2021ec6c7595fe1d7829fb2f58c101e130a2dde2ab1fca","missingness":null},{"formula_id":"formula_6","section_path_id":"1~39","section_ordinal":51,"label":null,"coordinates":null,"representation":{"plain_text":"] for s in capacity_in_supplier]) == roast_light[r] + roast_dark[r]"},"span":{"start":2743,"end":2810},"source_digest":"0c606f4b2b815e2171fd8044705680261029b2845df72589339f84bef494ba75","missingness":null},{"formula_id":"formula_7","section_path_id":"1~39","section_ordinal":51,"label":null,"coordinates":null,"representation":{"plain_text":"] for r in roasting_cost_light]) == light_coffee_needed_for_cafe[c] for c in dark_coffee_needed_for_cafe: prob += pulp.lpSum([ship_roastery_to_cafe_dark[(r, c)] for r in roasting_cost_dark]) == dark_coffee_needed_for_cafe[c] for r in roasting_cost_light: prob += pulp.lpSum([ship_roastery_to_cafe_light[(r, c)] for c in light_coffee_needed_for_cafe]) &lt;= roast_light[r] prob += pulp.lpSum([ship_roastery_to_cafe_dark[(r, c)] for c in dark_coffee_needed_for_cafe]) &lt;= roast_dark[r] # Solve prob.solve()"},"span":{"start":2904,"end":3410},"source_digest":"4469722ff529f58909755bf4e2063d6ec59748cf662c52044363f7073386a0a3","missingness":null},{"formula_id":"formula_8","section_path_id":"1~44","section_ordinal":56,"label":null,"coordinates":null,"representation":{"plain_text":"# Define SMT variables beans_shipped = {(s, r): Int(f'beans_shipped_{s}_{r}') for s in ['supplier1', 'supplier2', 'supplier3'] for r in ['roastery1', 'roastery2']} light_coffee_roasted = {r: Int(f'light_coffee_roasted_{r}') for r in ['roastery1', 'roastery2']} dark_coffee_roasted = {r: Int(f'dark_coffee_roasted_{r}') for r in ['roastery1', 'roastery2']} light_coffee_shipped = {(r, c): Int(f'light_coffee_shipped_{r}_{c}') for r in ['roastery1', 'roastery2'] for c in ['cafe1', 'cafe2', 'cafe3']} dark_coffee_shipped = {(r, c): Int(f'dark_coffee_shipped_{r}_{c}') for r in ['roastery1', 'roastery2'] for c in ['cafe1', 'cafe2', 'cafe3']} total_cost = Int('total_cost')"},"span":{"start":307,"end":977},"source_digest":"3c14eebc38e2c9d59cf4dc4180bd0db07157e49a64066c64d5b08697b1e83eff","missingness":null}],"formula_missingness":null,"page_text_missingness":null}