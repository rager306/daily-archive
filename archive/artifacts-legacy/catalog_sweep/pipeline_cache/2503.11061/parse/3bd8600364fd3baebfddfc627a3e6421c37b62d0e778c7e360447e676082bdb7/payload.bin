81.1.7</idno>\n\t\t<ptr target=\"https://doi.org/10.4007/annals.2015.181.1.7\" />\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Ann. of Math</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"issue\">2</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"383\" to=\"413\" />\n\t\t\t<date type=\"published\" when=\"2015\">2015</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b9\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">On primes in arithmetic progressions and bounded gaps between many primes</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">J</forename><surname>Stadlmann</surname></persName>\n\t\t</author>\n\t\t<ptr target=\"https://arxiv.org/abs/2309.00425\" />\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2023\">2023</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b10\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Narrow admissible tuples</title>\n\t\t<ptr target=\"https://math.mit.edu/~primegaps/\" />\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b11\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Finding narrow admissible tuples</title>\n\t\t<ptr target=\"https://michaelnielsen.org/polymath/index.php?title=Finding_narrow_admissible_tuples\" />\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b12\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Patternboost: Constructions in mathematics with a little help from ai</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">F</forename><surname>Charton</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">J</forename><forename type=\"middle\">S</forename><surname>Ellenberg</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">A</forename><forename type=\"middle\">Z</forename><surname>Wagner</surname></persName>\n\t\t<