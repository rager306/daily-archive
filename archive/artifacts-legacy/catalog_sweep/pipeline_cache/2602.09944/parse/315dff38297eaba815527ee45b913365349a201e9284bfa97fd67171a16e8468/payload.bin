</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Yang</forename><surname>Cao</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Muhammad</forename><forename type=\"middle\">Asif</forename><surname>Ali</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Hanbin</forename><surname>Wang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Lijie</forename><surname>Hu</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Di</forename><surname>Wang</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2506.00894</idno>\n\t\t<ptr target=\"https://arxiv.org/abs/2506.00894\" />\n\t\t<title level=\"m\">CODEMENV: Benchmarking Large Language Models on Code Migration</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2025\">2025</date>\n\t\t</imprint>\n\t</monogr>\n\t<note>cs.SE</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b6\">\n\t<monogr>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Aleksandra</forename><surname>Eliseeva</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Alexander</forename><surname>Kovrigin</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Ilia</forename><surname>Kholkin</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Egor</forename><surname>Bogomolov</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Yaroslav</forename><surname>Zharov</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2503.14443</idno>\n\t\t<title level=\"m\">Envbench: A benchmark for automated environment setup</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2025\">2025. 2025</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</bi