http://www.w3.org/1999/xlink\">\n\t<teiHeader xml:lang=\"en\">\n\t\t<fileDesc>\n\t\t\t<titleStmt>\n\t\t\t\t<title level=\"a\" type=\"main\">Optimus-1 : Hybrid Multimodal Memory Empowered Agents Excel in Long-Horizon Tasks</title>\n\t\t\t\t<funder ref=\"#_ckVr7hr\">\n\t\t\t\t\t<orgName type=\"full\">Shenzhen College Stability Support Plan</orgName>\n\t\t\t\t</funder>\n\t\t\t\t<funder ref=\"#_rEVShSN\">\n\t\t\t\t\t<orgName type=\"full\">Major Key Project of Peng Cheng Laboratory</orgName>\n\t\t\t\t</funder>\n\t\t\t\t<funder ref=\"#_NNgy8Kc #_neF6bc7\">\n\t\t\t\t\t<orgName type=\"full\">National Natural Science Foundation of China</orgName>\n\t\t\t\t</funder>\n\t\t\t\t<funder ref=\"#_h8uedNT\">\n\t\t\t\t\t<orgName type=\"full\">Natural Science Foundation of Guangdong Province of China</orgName>\n\t\t\t\t</funder>\n\t\t\t</titleStmt>\n\t\t\t<publicationStmt>\n\t\t\t\t<publisher/>\n\t\t\t\t<availability  status=\"unknown\">\n\t\t\t\t\t<licence/>\n\t\t\t\t</availability>\n\t\t\t\t<date type=\"published\" when=\"2024-10-21\">21 Oct 2024</date>\n\t\t\t</publicationStmt>\n\t\t\t<sourceDesc>\n\t\t\t\t<biblStruct status=\"extracted\">\n\t\t\t\t\t<analytic>\n\t\t\t\t\t\t<author>\n\t\t\t\t\t\t\t<persName><forename type=\"first\">Zaijing</forename><surname>Li</surname></persName>\n\t\t\t\t\t\t\t<affiliation key=\"aff0\">\n\t\t\t\t\t\t\t\t<orgName type=\"institution\">Harbin Institute of Technology</orgName>\n\t\t\t\t\t\t\t\t<address>\n\t\t\t\t\t\t\t\t\t<settlement>Shenzhen</settlement>\n\t\t\t\t\t\t\t\t</address>\n\t\t\t\t\t\t\t</affiliation>\n\t\t\t\t\t\t\t<affiliation key=\"aff1\">\n\t\t\t\t\t\t\t\t<orgName type=\"laboratory\">Peng Cheng Laboratory</orgName>\n\t\t\t\t\t\t\t</affiliation>\n\t\t\t\t\t\t</author>\n\t\t\t\t\t\t<author>\n\t\t\t\t\t\t\t<persName><forename type=\"first\">Yuquan</forename><surname>Xie</surname></persName>\n\t\t\t\t\t\t\t<email>xieyuquan20016@gmail.com</email>\n\t\t\t\t\t\t\t<affiliation key=\"aff0\">\n\t\t\t\t\t\t\t\t<orgName type=\"institution\">Harbi