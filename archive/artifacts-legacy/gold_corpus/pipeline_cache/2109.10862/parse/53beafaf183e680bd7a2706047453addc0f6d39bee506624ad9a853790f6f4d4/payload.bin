":"75d448130676d60c370209404edff6cee08ed6a6fd9abe10834213e3516ff17d"},{"row":5,"column":4,"colspan":1,"rowspan":1,"text":"0.1821","coordinates":null,"span":{"start":402,"end":408},"digest":"b357504a997d2fdb72624bd762bd0ba696c00950305ea7087878018217bce8a8"},{"row":6,"column":0,"colspan":1,"rowspan":1,"text":"175b first subtree RL","coordinates":null,"span":{"start":408,"end":429},"digest":"9307360201dabb7924da9251dbee2b3ae4140b6a2e6fbe58d6f72eba086c78df"},{"row":6,"column":1,"colspan":1,"rowspan":1,"text":"43.19","coordinates":null,"span":{"start":429,"end":434},"digest":"faf33e5d85f3ada4a69baceeabfb96a0744a52d3939fc3016b496f95ebcf1323"},{"row":6,"column":2,"colspan":1,"rowspan":1,"text":"10.63","coordinates":null,"span":{"start":434,"end":439},"digest":"cb167489d754a2d7b61fdee451f94b3965fd44584cb1be72d786667e02c9bf22"},{"row":6,"column":3,"colspan":1,"rowspan":1,"text":"17.10","coordinates":null,"span":{"start":439,"end":444},"digest":"1cc381a45184383b5a10a3bf028839f42f0a1ad47a4d64898b15557e23f25a46"},{"row":6,"column":4,"colspan":1,"rowspan":1,"text":"0.1778","coordinates":null,"span":{"start":444,"end":450},"digest":"1c0473bf4e4a03f15b25139d48ac6d5688aae13b2d6bff2392d709a6b3598e8b"},{"row":7,"column":0,"colspan":1,"rowspan":1,"text":"6b full tree RL","coordinates":null,"span":{"start":450,"end":465},"digest":"d7c83d186d91b5f7bb71dad9d5147e2b6adeceff8f5599cceef0971efc0f7d60"},{"row":7,"column":1,"colspan":1,"rowspan":1,"text":"36.79","coordinates":null,"span":{"start":465,"end":470},"digest":"76fcaf00a71ebcf8f382b66b329841438d7a5a98383b35d5f1802b0710e977b6"},{"row":7,"column":2,"colspan":1,"rowspan":1,"text":"7.22","coordinates":null,"span":{"start":470,"end":474},"digest":"b7e890b12f70b149741b62ae1fe346150ceff597cec8f4f97a571dd28d05413b"},{"row":7,"column":3,"colspan":1,"rowspan":1,"text":"14.84","coordinates":null,"span":{"start":474,"end":479},"digest":"08dffb176e60835c1d60b8d4748418431df2b4e47a0f03e12bd3d5d28acf6ef7"},{"row":7,"column":4,"colspan":1,"rowspan":1,"text":"0.1246","coordinates":null,"span":{"start":479,"end":485},"digest":"a3b535eb203ef3ca78588a203002fbaa12188a821d2ddae142439694b968c654"}],"source_digest":"0f31ab9e88bd1bae3919ebc178146eed6e6716be9b645e4e96e2604220801ba7","missingness":null}],"table_missingness":null,"formulas":[{"formula_id":"formula_0","section_path_id":"1~10","section_ordinal":30,"label":null,"coordinates":null,"representation":{"plain_text":"def"},"span":{"start":103,"end":106},"source_digest":"83de37f03a8d3be129b5971e393b671f6b6380b73f756f0be9bffb4fc86a4f49","missingness":null}],"formula_missingness":null,"page_text_missingness":null}