72.21 3.70</cell><cell>0.42</cell><cell cols=\"3\">88.41 88.89 0.97</cell><cell>0.01</cell><cell cols=\"3\">86.11 90.00 0.00</cell><cell>0.12</cell><cell>56.52 76.56 0.72</cell><cell>0.41</cell></row><row><cell>GPT o3</cell><cell>Java Python</cell><cell cols=\"3\">83.16 88.98 1.89 78.92 86.81 0.79</cell><cell>0.11 0.16</cell><cell cols=\"3\">80.84 86.23 0.00 71.28 78.54 0.11</cell><cell>0.17 0.26</cell><cell cols=\"3\">51.07 72.91 4.42 49.19 72.08 3.43</cell><cell>0.57 0.57</cell><cell cols=\"3\">91.80 94.13 0.00 78.48 87.04 1.27</cell><cell>0.07 0.16</cell><cell cols=\"3\">79.01 85.91 0.00 67.44 74.77 0.00</cell><cell>0.19 0.21</cell><cell>51.06 71.01 5.59 49.52 72.17 3.42</cell><cell>0.51 0.52</cell></row><row><cell></cell><cell cols=\"4\">Average 83.90 88.75 1.18</cell><cell>0.10</cell><cell cols=\"3\">77.27 83.13 0.24</cell><cell>0.19</cell><cell cols=\"3\">50.94 72.40 3.85</cell><cell>0.52</cell><cell cols=\"3\">86.23 90.02 0.75</cell><cell>0.08</cell><cell cols=\"3\">77.52 83.56 0.00</cell><cell>0.17</cell><cell>52.37 73.25 3.24</cell><cell>0.48</cell></row><row><cell></cell><cell>C/C++</cell><cell cols=\"3\">73.73 74.40 0.75</cell><cell>0.02</cell><cell cols=\"3\">67.55 75.44 0.23</cell><cell>0.29</cell><cell cols=\"3\">40.97 55.47 1.70</cell><cell>0.41</cell><cell cols=\"3\">75.36 75.36 1.45</cell><cell>0.00</cell><cell cols=\"3\">69.44 79.17 0.00</cell><cell>0.32</cell><cell>42.39 60.29 2.36</cell><cell>0.43</cell></row><row><cell>GPT</cell><cell>Java</cell><cell cols=\"3\">62.77 67.35 2.26</cell><cell>0.13</cell><cell cols=\"3\">67.94 76.18 0.41</cell><cell>0.37</cell><cell cols=\"3\">41.07 55.79 2.71</cell><cell>0.48</cell><cell cols=\"3\">73.77 75.41 0.00</cell><cell>0.10</cell><cell cols=\"3\">74.07 81.54 0.41</cell><cell>0.31</cell><cell>43.62 58.92 2.77</cell><cell>0.62</cell></row><row><cell>o4-mini</cell><cell>Python</cell><cell cols=\"3\">59.59 66.71 1.40</cell><cell>0.20</cell><cell cols=\"3\">56.08 66.31 0.00</cell><cell>0.49</cell><cell cols=\"3