owich</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Boyuan</forename><surname>Chen</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2507.05178</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2025\">2025</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b4\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Testing and understanding erroneous planning in llm agents through synthesized user inputs</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Zhenlan</forename><surname>Ji</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Daoyuan</forename><surname>Wu</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Pingchuan</forename><surname>Ma</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Zongjie</forename><surname>Li</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Shuai</forename><surname>Wang</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2404.17833</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b5\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Metal: A multi-agent framework for chart generation with test-time scaling</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Bingxuan</forename><surname>Li</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Yiwei</forename><surname>Wang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jiuxiang</forename><surname>Gu</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><f