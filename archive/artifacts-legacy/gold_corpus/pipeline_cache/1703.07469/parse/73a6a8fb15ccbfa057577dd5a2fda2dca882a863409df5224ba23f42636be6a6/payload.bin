uthor>\n\t\t\t<persName><surname>Badia</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Nature</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">538</biblScope>\n\t\t\t<biblScope unit=\"issue\">7626</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"471\" to=\"476\" />\n\t\t\t<date type=\"published\" when=\"2016\">2016</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b7\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Automating string processing in spreadsheets using input-output examples</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Sumit</forename><surname>Gulwani</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">ACM SIGPLAN Notices</title>\n\t\t<imprint>\n\t\t\t<publisher>ACM</publisher>\n\t\t\t<date type=\"published\" when=\"2011\">2011</date>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b8\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Spreadsheet data manipulation using examples. Communications of the</title>\n\t\t<author>\n\t\t\t<persName><surname>Gulwani</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Sumit</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><surname>Harris</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">R</forename><surname>William</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Rishabh</forename><surname>Singh</surname></persName>\n\t\t</author>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2012\">2012</date>\n\t\t\t<publisher>ACM</publisher>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b9\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Attention-based multimodal neural machine translation</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">