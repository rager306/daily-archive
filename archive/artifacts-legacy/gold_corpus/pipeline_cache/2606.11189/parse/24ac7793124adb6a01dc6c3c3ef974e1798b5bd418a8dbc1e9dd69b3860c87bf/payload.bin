<row><cell>Distill</cell><cell>19.89</cell><cell>20.31</cell><cell>5.01</cell><cell>26.72</cell><cell>52.65</cell><cell>25.32</cell></row><row><cell>TARGET-SFT</cell><cell>33.09</cell><cell>34.84</cell><cell>13.13</cell><cell>51.72</cell><cell>72.38</cell><cell>41.24</cell></row><row><cell></cell><cell></cell><cell cols=\"2\">Qwen2.5-Math-7B</cell><cell></cell><cell></cell><cell></cell></row><row><cell>Base</cell><cell>7.66</cell><cell>9.62</cell><cell>8.13</cell><cell>19.84</cell><cell>31.98</cell><cell>15.76</cell></row><row><cell>SFT</cell><cell>34.41</cell><cell>33.26</cell><cell>11.88</cell><cell>50.16</cell><cell>73.29</cell><cell>40.55</cell></row><row><cell>SFT (p)</cell><cell>27.33</cell><cell>28.28</cell><cell>11.24</cell><cell>37.19</cell><cell>57.25</cell><cell>32.20</cell></row><row><cell>Distill</cell><cell>42.04</cell><cell>39.94</cell><cell>13.32</cell><cell>62.34</cell><cell>80.26</cell><cell>47.36</cell></row><row><cell>TARGET-SFT</cell><cell>43.61</cell><cell>42.42</cell><cell>18.13</cell><cell>61.88</cell><cell>80.75</cell><cell>49.50</cell></row></table></figure>\n<figure xmlns=\"http://www.tei-c.org/ns/1.0\" type=\"table\" xml:id=\"tab_1\"><head>Table 2 :</head><label>2</label><figDesc>Medical Reasoning. Average@16 accuracy on medical reasoning benchmarks.</figDesc><table><row><cell></cell><cell cols=\"10\">MedMC MedQA PubMed MMLU-P GPQA Lancet MedB (4) MedB (5) MedX NEJM</cell><cell>Avg.</cell></row><row><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell>LLaMA-3.2-3B</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row><row><cell>Base</cell><cell>21.13</cell><cell>21.76</cell><cell>22.0</cell><cell>12.18</cell><cell>25.64</cell><cell>24.51</cell><cell>27.92</cell><cell>21.43</cell><cell>11.11</cell><cell>21.56</cell><cell>20.92</cell></row><row><cell>SFT</cell><cell>34.19</cell><cell>38.02</cell><cell>57.0</cell><cell>25.93</cell><cell>30.26</cell><cell>36.17</cell><cell>36.04</cell><cel