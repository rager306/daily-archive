cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell></row><row><cell>DeepSeek-V3</cell><cell>9</cell><cell>7</cell><cell>10</cell><cell>7</cell><cell>3</cell><cell>0</cell><cell>5</cell><cell>0</cell></row><row><cell>gemma-3n-E4B-it</cell><cell>30</cell><cell>30</cell><cell>30</cell><cell>29</cell><cell>27</cell><cell>15</cell><cell>27</cell><cell>14</cell></row><row><cell>LFM2-24B-A2B</cell><cell>3</cell><cell>4</cell><cell>5</cell><cell>2</cell><cell>5</cell><cell>7</cell><cell>6</cell><cell>7</cell></row><row><cell cols=\"2\">Meta-Llama-3.1-8B-Ins... 0</cell><cell>0</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row></table></figure>\n<figure xmlns=\"http://www.tei-c.org/ns/1.0\" type=\"table\" xml:id=\"tab_10\"><head>Table 12 :</head><label>12</label><figDesc>Minimum of highest shock level per model and condition.</figDesc><table><row><cell></cell><cell>DC</cell><cell>DC</cell><cell>DC</cell><cell>DC</cell><cell>PC</cell><cell>PC</cell><cell>PC</cell><cell>PC</cell></row><row><cell></cell><cell>NS</cell><cell>NS</cell><cell>WS</cell><cell>WS</cell><cell>NS</cell><cell>NS</cell><cell>WS</cell><cell>WS</cell></row><row><cell></cell><cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell></row><row><cell>DeepSeek-V3</cell><cell>8</cell><cell>9</cell><cell>8</cell><cell>9</cell><cell>6</cell><cell>3</cell><cell>2</cell><cell>4</cell></row><row><cell>gemma-3n-E4B-it</cell><cell>12</cell><cell>12</cell><cell>12</cell><cell>0</cell><cell>8</cell><cell>6</cell><cell>8</cell><cell>6</cell></row><row><cell>LFM2-24B-A2B</cell><cell>12</cell><cell>3</cell><cell>10</cell><cell>10</cell><cell>12</cell><cell>10</cell><cell>10</cell><cell>7</cell></row><row><cell>Meta-Llama</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row></table></figure>\n<figure xmlns=\"http://www.tei-c.org/ns/1.0\" type=\"table\" xml:id=\"tab_11\"><head>Table 13 :</head><label>13</label><figDesc>Maximum lower bound of earliest soft-refused button (resistance onset) per model and condition.</figDesc><table><row><cell></cell><cell>DC</cell><cell>DC</cell><cell>DC</cell><cell>DC</cell><cell>PC</cell><cell>PC</cell><cell>PC</cell><cell>PC</cell></row><row><cell></cell><cell>NS</cell><cell>NS</cell><cell>WS</cell><cell>WS</cell><cell>NS</cell><cell>NS</cell><cell>WS</cell><cell>WS</cell></row><row><cell></cell><cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell><cell>FB</cell><cell>NF</cell></row><row><cell>DeepSeek-V3</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>10</cell><cell>13</cell><cell>11</cell></row><row><cell>gemma-3n-E4B-it</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell></row><row><cell>LFM2-24B-A2B</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell></row><row><cell cols=\"2\">Meta-Llama-3.1-8B-Ins... 10</cell><cell>8</cell><cell>10</cell><cell>8</cell><cell>8</cell><cell>6</cell><cell>10</cell><cell>5</cell></row><row><cell>MiniMax-M2.5</cell><cell>10</cell><cell>7</cell><cell>10</cell><cell>4</cell><cell>10</cell><cell>13</cell><cell>10</cell><cell>4</cell></row><row><cell cols=\"2\">Mistral-Small-24B-Inst... 12</cell><cell>10</cell><cell>13</cell><cell>10</cell><cell>10</cell><cell>10</cell><cell>13</cell><cell>11</cell></row><row><cell>Kimi-K2.5</cell><cell>10</cell><cell>10</cell><cell>12</cell><cell>10</cell><cell>10</cell><cell>9</cell><cell>12</cell><cell>9</cell></row><row><cell>gpt-oss-120b</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell></row><row><cell>gpt-oss-20B</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cell><cell>13</cel