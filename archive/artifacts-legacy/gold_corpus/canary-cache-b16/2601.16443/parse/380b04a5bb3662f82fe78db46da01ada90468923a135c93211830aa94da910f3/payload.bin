rename><surname>Cohen</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jonas</forename><surname>Gehring</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jacob</forename><surname>Kahn</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jannik</forename><surname>Kossen</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Felix</forename><surname>Kreuk</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Emily</forename><surname>Mcmilin</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Michel</forename><surname>Meyer</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Yuxiang</forename><surname>Wei</surname></persName>\n\t\t</author>\n\t\t<idno type=\"arXiv\">arXiv:2510.02387</idno>\n\t\t<title level=\"m\">An open-weights llm for research on code generation with world models</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2025\">2025</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"report_type\">arXiv preprint</note>\n\t<note>Preprint</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b2\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Cognitive behaviors that enable self-improving reasoners, or, four habits of highly effective stars</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Kanishk</forename><surname>Gandhi</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Ayush</forename><surname>Chakravarthy</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Anikait</forename><surname>Singh</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Nathan</forename><surname>Lile</surname></persName>\n\t\t</author>\n\t\t<author>\n\