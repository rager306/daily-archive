tic>\n\t\t<title level=\"a\" type=\"main\">&lt;i&gt;Tadir u-mekuddash&lt;/i&gt;: which takes precedence: the more constant or the more sacred?</title>\n\t\t<idno type=\"DOI\">10.1017/cbo9780511557361.022</idno>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">The Talmudic Argument</title>\n\t\t<imprint>\n\t\t\t<publisher>Cambridge University Press</publisher>\n\t\t\t<date type=\"published\" when=\"1984-09-13\" />\n\t\t\t<biblScope unit=\"page\" from=\"174\" to=\"181\" />\n\t\t</imprint>\n\t</monogr>\n\t<note>which takes a single argument s</note>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b103\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">The function is called with the argument &quot;hi&quot;, so within the function, s is ↩→ initially &quot;hi</title>\n\t\t<imprint/>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"consolidated\" source=\"crossref\" xml:id=\"b104\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">Nothing Turned Itself Inside Out …</title>\n\t\t<idno type=\"DOI\">10.5040/9798765106709.ch-6</idno>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2025\" />\n\t\t\t<publisher>Bloomsbury Publishing Inc</publisher>\n\t\t\t<biblScope unit=\"page\" from=\"75\" to=\"86\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"consolidated\" source=\"crossref\" xml:id=\"b105\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Loose Ends … False Stars</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Sydney</forename><surname>Brenner</surname></persName>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.1142/9789811208188</idno>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">Loose Ends ... False Starts</title>\n\t\t<imprint>\n\t\t\t<publisher>WORLD SCIENTIFIC</publisher>\n\t\t\t<date type=\"published\" when=\"2019-07-07\" />\n\t\t\t<biblScope unit=\"page\" from=\"1\" to=\"285\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"consolidated\" source=\"crossref\" xml:id=\"b106\"