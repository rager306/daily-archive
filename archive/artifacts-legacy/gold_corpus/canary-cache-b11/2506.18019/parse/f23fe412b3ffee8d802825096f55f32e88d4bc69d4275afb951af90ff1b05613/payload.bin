ame>Wei</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Jirong</forename><surname>Wen</surname></persName>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.1007/s11704-024-40231-1</idno>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Frontiers of Computer Science</title>\n\t\t<title level=\"j\" type=\"abbrev\">Front. Comput. Sci.</title>\n\t\t<idno type=\"ISSN\">2095-2228</idno>\n\t\t<idno type=\"ISSNe\">2095-2236</idno>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">18</biblScope>\n\t\t\t<biblScope unit=\"issue\">6</biblScope>\n\t\t\t<biblScope unit=\"page\">186345</biblScope>\n\t\t\t<date type=\"published\" when=\"2024-03-22\">2024</date>\n\t\t\t<publisher>Springer Science and Business Media LLC</publisher>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"consolidated\" source=\"crossref\" xml:id=\"b3\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">ExpeL: LLM Agents Are Experiential Learners</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Andrew</forename><surname>Zhao</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Daniel</forename><surname>Huang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Quentin</forename><surname>Xu</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Matthieu</forename><surname>Lin</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Yong-Jin</forename><surname>Liu</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Gao</forename><surname>Huang</surname></persName>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.1609/aaai.v38i17.29936</idno>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\">Proceedings of the AAAI Conference on Artificial Intelligence</title>\n\t\t<title level=\"j\" type=\"abbrev\">AAAI</title>\n\t\t<idno type=\"ISSN\">2159-5399</idno>\n\t\t<idno type=\"ISSNe\">2374-3468</idno>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">38</biblScope>\n\t\t\t<biblScope unit=\"issue\">17</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"19632\" to=\"19642\" />\n\t\t\t<date type=\"published\" when=\"2024-03-24\">2024</date>\n\t\t\t<publisher>Association for the Advancement of Artificial Intelligence (AAAI)</publisher>\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"extracted\" xml:id=\"b4\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\">Agile: A novel reinforcement learning framework of llm agents</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">F</forename><surname>Peiyuan</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Y</forename><surname>He</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">G</forename><surname>Huang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Y</forename><surname>Lin</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">H</forename><surname>Zhang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">Y</forename><surname>Zhang</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">H</forename><surname>Li</surname></persName>\n\t\t</author>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"m\">Advances in Neural Information Processing Systems</title>\n\t\t<imprint>\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t\t<biblScope unit=\"volume\">37</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"5244\" to=\"5284\" />\n\t\t</imprint>\n\t</monogr>\n</biblStruct>\n\n<biblStruct status=\"consolidated\" source=\"crossref\" xml:id=\"b5\">\n\t<monogr>\n\t\t<title level=\"m\" type=\"main\">ArXiv preprint server clamps down on AI slop</title>\n\t\t<author>\n\t\t\t<persName><forename type=\"first\">T</forename><s