of Technology\n\t\t\n\t\n\tPhD thesis","doi":null,"arxiv_id":null,"title":null},{"raw_text":"Multi-scale context aggregation by dilated convolutions\n\t\t\n\t\t\tFisherYu\n\t\t\n\t\t\n\t\t\tVladlenKoltun\n\t\t\n\t\t\n\t\n\t\n\t\tICLR\n\t\t\n\t\t\t2016","doi":null,"arxiv_id":null,"title":"Multi-scale context aggregation by dilated convolutions"},{"raw_text":"An example of context-dependent label format for HMM-based speech synthesis in English\n\t\t\n\t\t\tHeigaZen\n\t\t\n\t\t\n\t\t\n\t\t\t2006","doi":null,"arxiv_id":null,"title":null}],"layout_json":null,"tei_xml":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<TEI xml:space=\"preserve\" xmlns=\"http://www.tei-c.org/ns/1.0\" \nxmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \nxsi:schemaLocation=\"http://www.tei-c.org/ns/1.0 https://raw.githubusercontent.com/kermitt2/grobid/master/grobid-home/schemas/xsd/Grobid.xsd\"\n xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\t<teiHeader xml:lang=\"en\">\n\t\t<fileDesc>\n\t\t\t<titleStmt>\n\t\t\t\t<title level=\"a\" type=\"main\">WAVENET: A GENERATIVE MODEL FOR RAW AUDIO Aäron van den Oord</title>\n\t\t\t</titleStmt>\n\t\t\t<publicationStmt>\n\t\t\t\t<publisher/>\n\t\t\t\t<availability  status=\"unknown\">\n\t\t\t\t\t<licence/>\n\t\t\t\t</availability>\n\t\t\t\t<date type=\"published\" when=\"2016-09-19\">19 Sep 2016</date>\n\t\t\t</publicationStmt>\n\t\t\t<sourceDesc>\n\t\t\t\t<biblStruct status=\"extracted\">\n\t\t\t\t\t<analytic>\n\t\t\t\t\t\t<author>\n\t\t\t\t\t\t\t<persName><forename type=\"first\">Sander</forename><surname>Dieleman</surname></persName>\n\t\t\t\t\t\t\t<email>sedielem@google.com</email>\n\t\t\t\t\t\t</author>\n\t\t\t\t\t\t<author>\n\t\t\t\t\t\t\t<persName><forename type=\"first\">Heiga</forename><surname>Zen</surname></persName>\n\t\t\t\t\t\t\t<email>heigazen@google.com</email>\n\t\t\t\t\t\t\t<affiliation key=\"aff1\">\n\t\t\t\t\t\t\t\t<address>\n\t\t\t\t\t\t\t\t\t<settlement>Google London</settlement>\n\t\t\t\t\t\t\t\t\t<country key=\"GB\">UK</count