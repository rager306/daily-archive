# Gold corpus reports are tracked evidence; content-addressed payload caches are local.
artifacts/gold_corpus/canary-cache-*/
artifacts/gold_corpus/pipeline_cache/

# M213 hybrid gate runtime outputs (selection.json stays tracked)
artifacts/m213-hybrid-gate/runs/
artifacts/m213-hybrid-gate/runs-live/
artifacts/m213-hybrid-gate/runs-live-20/
# Governor trajectory report is regenerated on EVERY governor run (including the
# pre-commit hook). While it was tracked, each run moved the milestone verification
# source revision, so milestone validation went stale on its own and the tree was
# never clean — this blocked M507 closeout. Derived report, never source truth.
artifacts/project-trajectory/
# The S08 observation surface is regenerated by every acceptance run and labels
# itself `reproducible: false` / `not_a_receipt: true`. Tracking it meant each
# acceptance run dirtied the tree and moved the verification source revision.
# The deterministic receipt (native_core_smp.json) stays tracked; its noisy
# sibling does not.
artifacts/parse_compat/native_core_smp_observations.json
artifacts/m213-hybrid-gate/runs-live-scholarly/
artifacts/m213-hybrid-gate/runs-live-scholarly-20/
artifacts/m213-hybrid-gate/runs-live-expand/

artifacts/m217-grobid-etl-smoke/
artifacts/m222-gnn-textbook/
artifacts/m222-catalog-source-inventory/

artifacts/m223-multi-source/
artifacts/wave-b/human_go-test.json
artifacts/etl/gold-pdf-cache/
artifacts/etl/m283-hybrid-layout/runs/

