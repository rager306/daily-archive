{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daily-archive.local/schemas/daily-archive.pdf-batch-manifest.v1.json",
  "title": "Daily Archive PDF Batch Manifest v1",
  "description": "Versioned, replayable PDF batch manifest for daily-archive parser ingest and validation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "batch_id",
    "created_at",
    "source_uris",
    "pdfs",
    "safety_defaults"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "daily-archive.pdf-batch-manifest.v1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable milestone or artifact batch identifier such as m054-pdf-acquisition."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Input JSON or markdown artifacts used to build this manifest."
    },
    "source_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Remote source URIs represented by this batch."
    },
    "ingest_commit": {
      "type": [
        "string",
        "null"
      ],
      "description": "Git commit used for ingest when known."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_defaults": {
      "$ref": "#/definitions/safety_defaults"
    },
    "pdfs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/pdf_item"
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pdf_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "missing_pdf_count": {
          "type": "integer",
          "minimum": 0
        },
        "parser_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "definitions": {
    "safety_defaults": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "external_network_authorized",
        "graph_writes_authorized",
        "production_import_authorized",
        "fact_promotion_authorized",
        "llm_calls_authorized"
      ],
      "properties": {
        "external_network_authorized": {
          "type": "boolean",
          "const": false,
          "description": "External network access is not authorized for manifest replay by default."
        },
        "graph_writes_authorized": {
          "type": "boolean",
          "const": false,
          "description": "Graph writes are disabled unless a later binding explicitly changes this."
        },
        "production_import_authorized": {
          "type": "boolean",
          "const": false,
          "description": "Production import is not authorized for diagnostic parser outputs."
        },
        "fact_promotion_authorized": {
          "type": "boolean",
          "const": false,
          "description": "Fact promotion is disabled for retroactive manifests."
        },
        "llm_calls_authorized": {
          "type": "boolean",
          "const": false,
          "description": "LLM calls are not authorized by this ingest contract."
        }
      },
      "examples": [
        {
          "external_network_authorized": false,
          "graph_writes_authorized": false,
          "production_import_authorized": false,
          "fact_promotion_authorized": false,
          "llm_calls_authorized": false
        }
      ]
    },
    "parser_expectation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version",
        "mode",
        "expected_output_schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "grobid",
            "opendataloader",
            "plotextractor"
          ]
        },
        "version": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "examples": [
            "header",
            "fulltext",
            "layout",
            "figure-caption",
            "batch-summary"
          ]
        },
        "expected_output_schema": {
          "type": "string",
          "description": "Relative path to JSON Schema file."
        },
        "output_path_template": {
          "type": "string",
          "description": "Relative path template. {arxiv_id} is replaced per PDF."
        },
        "batch_output_path": {
          "type": "string",
          "description": "Relative path for batch-level outputs."
        },
        "required_for_validation": {
          "type": "boolean"
        },
        "diagnostic_only": {
          "type": "boolean"
        }
      }
    },
    "byte_range": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string"
        }
      }
    },
    "pdf_item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "arxiv_id",
        "source_uri",
        "storage_provider",
        "path",
        "size_bytes",
        "content_sha256",
        "expected_parsers"
      ],
      "properties": {
        "arxiv_id": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{4,5}(v\\d+)?$"
        },
        "article_key": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "source_uri": {
          "type": "string"
        },
        "storage_provider": {
          "type": "string",
          "enum": [
            "local",
            "r2",
            "s3",
            "http",
            "unknown"
          ]
        },
        "path": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/byte_range"
          }
        },
        "expected_parsers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/parser_expectation"
          }
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "daily-archive.pdf-batch-manifest.v1",
      "batch_id": "m054-pdf-acquisition",
      "created_at": "2026-06-12T00:00:00+00:00",
      "generated_by": "scripts/m059_build_manifest.py",
      "source_artifacts": [
        "artifacts/m054-pdf-acquisition/target-subset.json"
      ],
      "source_uris": [
        "https://arxiv.org/pdf/1804.02767"
      ],
      "ingest_commit": null,
      "safety_defaults": {
        "external_network_authorized": false,
        "graph_writes_authorized": false,
        "production_import_authorized": false,
        "fact_promotion_authorized": false,
        "llm_calls_authorized": false
      },
      "pdfs": [
        {
          "arxiv_id": "1804.02767",
          "source_uri": "https://arxiv.org/pdf/1804.02767",
          "storage_provider": "local",
          "path": "data/article_catalog/article_catalog/arxiv/cs-cv/1804.02767/source/1804.02767.pdf",
          "size_bytes": 2456177,
          "content_sha256": "37049049b5e06f67c6cd22b72f7b9352914b0eb3a03e99abf54594c1005a8468",
          "expected_parsers": [
            {
              "name": "grobid",
              "version": "m055-retroactive",
              "mode": "header",
              "expected_output_schema": "schemas/grobid-tei.v1.json",
              "output_path_template": "artifacts/m055-parser-benchmark/grobid-only/per-pdf/{arxiv_id}.json"
            }
          ]
        }
      ],
      "aggregate": {
        "pdf_count": 1,
        "total_size_bytes": 2456177,
        "missing_pdf_count": 0,
        "parser_count": 1
      }
    }
  ],
  "x_contract_notes": [
    "Future M061+ parser batches must be created from this manifest before processing starts.",
    "This schema is intentionally permissive for retroactive artifacts.",
    "Unknown fields are retained so historical parser outputs remain replayable.",
    "Consumers should validate required contract fields first, then inspect optional diagnostics.",
    "Relative paths are resolved from the repository root unless stated otherwise.",
    "Timestamps use ISO-8601 strings with timezone when available.",
    "All write-like safety switches default to false and must remain explicit.",
    "Batch processing is diagnostic-only until a later ADR grants production authority.",
    "Schema evolution should add a v2 file rather than weakening this v1 contract in place.",
    "Examples are normative shape examples, not a complete corpus manifest.",
    "Parser-specific fields may be richer than the fields listed here.",
    "Consumers should preserve arxiv_id strings exactly, including version suffixes.",
    "SHA-256 values describe local content bytes, not remote HTTP responses.",
    "Paths may point to historical artifacts generated by earlier milestones.",
    "Network endpoints in examples use 127.0.0.1 when a loopback endpoint is needed.",
    "This schema is a contract boundary, not an authorization boundary."
  ]
}
