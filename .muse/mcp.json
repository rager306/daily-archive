{
  "mcpServers": {
    "gitnexus": {
      "command": "gitnexus",
      "args": [
        "mcp"
      ]
    },
    "codebase-memory-mcp": {
      "command": "/root/.local/bin/codebase-memory-mcp",
      "args": []
    },
    "jina": {
      "url": "https://mcp.jina.ai/v1",
      "headers": {
        "Authorization": "Bearer ${env:JINA_API_KEY}"
      }
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${env:EXA_API_KEY}"
      }
    },
    "consensus": {
      "url": "https://mcp.consensus.app/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CONSENSUS_API_KEY}"
      }
    },
    "keenable": {
      "url": "https://api.keenable.ai/mcp",
      "headers": {
        "X-API-Key": "${env:KEENABLE_API_KEY}"
      },
      "type": "streamable-http"
    }
  }
}
