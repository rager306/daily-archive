{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-archive.local/schemas/pipeline-integrity-review.v1.schema.json",
  "title": "daily-archive pipeline integrity review finding",
  "description": "Schema for one JSONL review finding. Each line in the dataset MUST validate independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "finding_id",
    "area",
    "title",
    "severity",
    "priority",
    "status",
    "maturity",
    "claim",
    "risk",
    "evidence",
    "standards",
    "dependencies",
    "remediation",
    "verification",
    "governor",
    "labels"
  ],
  "properties": {
    "schema_version": {"const": "pipeline-integrity-review.v1"},
    "review_id": {"type": "string", "pattern": "^REV-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"},
    "finding_id": {"type": "string", "pattern": "^PIR-[0-9]{3}$"},
    "area": {
      "enum": [
        "pipeline",
        "cache",
        "revision_identity",
        "temporal_ast",
        "context_conservation",
        "assurance",
        "fsm",
        "agent_readiness",
        "multimodal",
        "schema",
        "persistence",
        "observability"
      ]
    },
    "title": {"type": "string", "minLength": 8, "maxLength": 180},
    "severity": {"enum": ["blocker", "high", "medium", "low", "info"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "status": {"enum": ["open", "in_progress", "blocked", "resolved", "accepted_risk", "superseded"]},
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "target"],
      "properties": {
        "current": {"type": "number", "minimum": 0, "maximum": 5},
        "target": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "claim": {"type": "string", "minLength": 10},
    "risk": {"type": "string", "minLength": 10},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "note"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "symbol": {"type": "string"},
          "line_hint": {"type": "string"},
          "note": {"type": "string", "minLength": 3}
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^PIR-[0-9]{3}$"},
      "uniqueItems": true
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "steps", "acceptance_criteria"],
      "properties": {
        "objective": {"type": "string", "minLength": 8},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}}
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "ref", "expected"],
        "properties": {
          "mode": {"enum": ["governor_rule", "command", "artifact", "runtime", "human", "llm"]},
          "ref": {"type": "string", "minLength": 1},
          "command": {"type": "string"},
          "expected": {"type": "string", "minLength": 3}
        }
      }
    },
    "governor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "existing_rules", "proposed_rule_id"],
      "properties": {
        "coverage": {"enum": ["existing", "partial", "gap", "not_applicable"]},
        "existing_rules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "proposed_rule_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]+$"}
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
      "uniqueItems": true
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessed_at", "source_revision", "owning_wave"],
      "properties": {
        "assessed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
        "source_revision": {"type": "string", "minLength": 5},
        "owning_wave": {"type": "string", "minLength": 2},
        "note": {"type": "string"}
      }
    }
  }
}
