{
  "schema_version": "source-manifest.v1",
  "source_id": "company_blog",
  "title": "Company engineering blog",
  "description": "Engineering blog posts with technical content",
  "reliability_tier": 3,
  "locator": {
    "type": "url",
    "pattern": ".+",
    "examples": [
      "pageindex_zhang2025pageindex",
      "vasiliev2026knowledge-graph-memory-graph"
    ]
  },
  "assets_policy": {
    "primary_format": "html",
    "sidecar_formats": [
      "markdown"
    ],
    "requires_fulltext_license": false,
    "versioning_model": "none"
  },
  "parser_profile": "html_navigation",
  "identity_mapping": {
    "paper_key_field": "post_id"
  }
}
