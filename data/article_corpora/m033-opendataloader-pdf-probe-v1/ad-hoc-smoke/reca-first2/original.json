    "font" : "TimesNewRomanPSMT",
    "font size" : 5.584,
    "text color" : "[0.13330282270908356, 0.13330282270908356, 0.13330282270908356]",
    "content" : "Per-shot duration is decided by the model, not a fixed grid short beats stay short (12s), long beats can breathe (65s)."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 92,
