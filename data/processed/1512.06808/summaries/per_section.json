  "sections_sha256": "7f411c75d964c7d4831e2fb6316828dc1bc290f0fdc6c2fedcc63bad20585037",
  "summaries": [
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section establishes the historical origins of game theory, tracing its development to pioneers Ernst Zermelo (1913) and John von Neumann (1928), with a major breakthrough by von Neumann and Oscar Morgenstern.",
      "title": "Introduction"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section introduces the framework of ordinal games in strategic form, defining game theory as the study of interactive situations where players' decisions jointly determine outcomes, and illustrates the concept with a point example.",
      "title": "Ordinal games in strategic form"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section presents Table 1.1, illustrating a split-or-steal game between Sarah and Steven with four possible payoff outcomes depending on their mutual choices.",
      "title": "Split"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section discusses Sarah's ordinal ranking of outcomes under the assumption she is selfish and greedy, focusing exclusively on her own monetary payoff and preferring more money to less.",
      "title": "Table 1.2"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section introduces preference notation with an example involving Alice and Bob's food preferences, using symbols like M ≻ J (Alice prefers Mexican to Japanese) and J ∼ M (Bob is indifferent).",
      "title": "Table 1.3"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section formally defines an ordinal game in strategic form as a quintuple consisting of a game-frame and a preference profile assigning each player a preference ordering over outcomes.",
      "title": "Definition 1.3"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section introduces two relations on the set of strategies—strict and weak dominance—before providing formal definitions, illustrating the concepts with a preliminary example.",
      "title": "Strict and weak dominance"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section uses Table 1.6 to illustrate strict dominance, showing that strategy A strictly dominates strategy B for Player 1 because A yields a payoff of 3 against E while B yields less.",
      "title": "Table 1.6"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section summarizes the dominance relationships in the game from Table 1.6: A strictly dominates B and D, A and C are equivalent, and B is strictly dominated by C.",
      "title": "E F"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section presents Table 1.7, describing a scenario where Doug and Ed are willing to sacrifice family time for a prize but are envious of each other, meaning they prefer nobody receives the prize over the other person receiving it.",
      "title": "Table 1.7"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section describes the second-price (Vickrey) auction as an example of a game with a weak dominant-strategy equilibrium, where sealed bids are submitted without knowledge of others' bids.",
      "title": "Second-price auction"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section introduces the pivotal mechanism, beginning with a Davis Enterprise article about a city council decision on January 12, 2001, regarding consensus ordering.",
      "title": "The pivotal mechanism"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section analyzes a project scenario where Individual 1 gains utility of 13 while Individual 2 suffers a loss of 15, resulting in Pareto inefficiency since the loss exceeds the gain.",
      "title": "Utility of individual 2"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section establishes that if a player has a weakly or strictly dominant strategy, they ought to choose it, since under strict dominance choosing any other strategy guarantees a worse outcome.",
      "title": "Iterated deletion procedures"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section formally defines the Iterated Deletion of Strictly Dominated Strategies (IDSDS) as an algorithm that, given a finite ordinal strategic-form game, successively removes strictly dominated strategies to produce reduced games.",
      "title": "IDSDS"
    },
    {
      "path_id": 1,
      "section_id": 1512.06808,
      "summary": "This section states Remark 1.5: in finite games, the order of deleting strictly dominated strategies is irrelevant, as any sequence of deletions leads to the same outcome.",
      "title": "Figure 1.10"
    }
  ]
}