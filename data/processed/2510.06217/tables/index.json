[
 {
  "table_id": "tab_0",
  "section_path_id": "1~23",
  "section_ordinal": 35,
  "caption": "Table 1 :",
  "cells": [
   {
    "row": 0,
    "column": 0,
    "colspan": 1,
    "rowspan": 1,
    "text": "Why do PRMs fail on table-involved reasoning steps? Next, we take a closer look at why PRMs",
    "coordinates": null,
    "span": {
     "start": 990,
     "end": 1081
    },
    "digest": "7d80f49139d2e50f68e65634e3bceadfde6627c22f9a888f8d5235b615ebf2b7"
   },
   {
    "row": 1,
    "column": 0,
    "colspan": 1,
    "rowspan": 1,
    "text": "lose their supervisory effectiveness when reasoning steps involve table operations. For Table Retrieval",
    "coordinates": null,
    "span": {
     "start": 1081,
     "end": 1184
    },
    "digest": "ff978847c470aec52fa56c770b85b70fd34c504371828f584f79fd793fea2373"
   },
   {
    "row": 2,
    "column": 0,
    "colspan": 1,
    "rowspan": 1,
    "text": "Steps, we conduct a contrastive experiment focusing particularly on the table contents retrieved by",
    "coordinates": null,
    "span": {
     "start": 1184,
     "end": 1283
    },
    "digest": "bc4e9ffba77dacb24ce0ee349dc4b4126f0863dd3ff70301559a4143e224778e"
   },
   {
    "row": 3,
    "column": 0,
    "colspan": 1,
    "rowspan": 1,
    "text": "LRMs within their responses. We randomly sampled 500 responses and constructed two variants by (i)",
    "coordinates": null,
    "span": {
     "start": 1283,
     "end": 1381
    },
    "digest": "cad056ec486307c915983e45baabc1b0cb2b3f6c651f68649f14c9a3bf63a029"
   },
   {
    "row": 4,
    "column": 0,
    "colspan": 1,
    "rowspan": 1,
    "text": "retaining the original LRM-retrieved sub-table, and (ii) replacing it with a randomly selected sub-table",
    "coordinates": null,
    "span": {
     "start": 1381,
     "end": 1485
    },
    "digest": "910c426c310ae335ec3af1c6745a44e554dd34d0e045287dbdb27df34b8a08d5"
   },
   {
    "row": 5,
    "column": 0,
    "colspan": 1,
    "rowspan": 1,
    "text": "region from the original input table. Figure 3 (left) shows the output rewards of Qwen2.5-Math-PRM-",
    "coordinates": null,
    "span": {
     "start": 1485,
     "end": 1584
    },
    "digest": "80aca887a7574c50eaaacae795fcb158733c6d1486b9a19725a9ffff393b1a6c"
   }
  ],
  "source_digest": "b5573b8805a8c02941e0396fcd4664b4e25d9b4b923f0ce070940861359122c1",
  "missingness": null
 },
