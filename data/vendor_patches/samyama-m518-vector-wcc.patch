+                    );
+                    assert_eq!(checked.exact.values().map(Vec::len).sum::<usize>(), count);
+                    assert_eq!(
+                        checked.search(&old, 1).unwrap(),
+                        vec![(NodeId::new(2), 0.0)]
+                    );
+                    assert_eq!(
+                        checked.search(&replacement, 1).unwrap(),
+                        vec![(NodeId::new(1), 0.0)]
+                    );
+                }
+            }
+        }
+    }
