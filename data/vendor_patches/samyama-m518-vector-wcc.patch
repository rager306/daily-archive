+                        }
+                        (Backend::F16(h), Quantization::Fp16) => {
+                            assert_eq!(h.get_nb_point(), count);
+                            assert_eq!(checked.stored_f16.len(), count);
+                            assert!(checked.stored_f32.is_empty());
+                        }
+                        _ => panic!("replacement changed the backend precision"),
+                    }
+                    assert_eq!(backend_vectors(checked), expected);
+                    assert_eq!(checked.exact_matches(&old), vec![(NodeId::new(2), 0.0)]);
+                    assert_eq!(
+                        checked.exact_matches(&replacement),
