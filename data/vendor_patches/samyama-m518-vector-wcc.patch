+    fn replacement_rebuilds_both_search_paths_and_survives_dump_reload() {
+        let dir = tempfile::tempdir().unwrap();
+        for quantization in [Quantization::None, Quantization::Fp16] {
+            for count in [3usize, 160] {
+                let old = vec![0.0, 1.0, 0.0];
+                let replacement = vec![1.0, 0.0, 0.0];
+                let mut index =
+                    VectorIndex::with_quantization(3, DistanceMetric::InnerProduct, quantization);
+                let mut expected = Vec::new();
+                for i in 0..count {
+                    let vector = if i < 2 {
+                        old.clone()
+                    } else {
+                        vec![0.0, 1.0, i as f32 / 256.0]
+                    };
+                    index.add(NodeId::new(i as u64 + 1), &vector).unwrap();
+                    expected.push((
+                        i as u64 + 1,
+                        if i == 0 { replacement.clone() } else { vector },
+                    ));
+                }
+                assert_eq!(
+                    index.exact_matches(&old),
+                    vec![(NodeId::new(1), 0.0), (NodeId::new(2), 0.0)]
+                );
+                assert_eq!(
+                    index.search(&old, 2).unwrap(),
+                    vec![(NodeId::new(1), 0.0), (NodeId::new(2), 0.0)]
+                );
+                index.replace(NodeId::new(1), &replacement).unwrap();
+                index.replace(NodeId::new(1), &replacement).unwrap();
+                let path = dir.path().join(format!("{quantization:?}-{count}.hnsw"));
+                index.dump(&path).unwrap();
+                let stored: Vec<StoredVector> =
+                    bincode::deserialize_from(std::fs::File::open(&path).unwrap()).unwrap();
+                let dumped: Vec<_> = stored.into_iter().map(|v| (v.node_id, v.vector)).collect();
+                assert_eq!(dumped, expected);
+                let loaded = VectorIndex::load_with_quantization(
+                    &path,
+                    3,
+                    DistanceMetric::InnerProduct,
+                    quantization,
+                )
+                .unwrap();
+
+                for checked in [&index, &loaded] {
+                    assert_eq!(checked.len(), count);
+                    assert_eq!(checked.dimensions(), 3);
+                    assert_eq!(checked.metric(), DistanceMetric::InnerProduct);
+                    assert_eq!(checked.quantization(), quantization);
+                    match (&checked.backend, quantization) {
+                        (Backend::F32(h), Quantization::None) => {
+                            assert_eq!(h.get_nb_point(), count);
+                            assert_eq!(checked.stored_f32.len(), count);
