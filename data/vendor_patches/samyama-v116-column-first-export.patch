+    // getter `node_property` merges row and column with the column winning,
+    // and the snapshot must round-trip exactly that value. Upstream 1.16
+    // prefers the row here; see data/vendor_patches in the consumer repo.
     let mut store = GraphStore::new();
     let n = store.create_node("Doc");
     store.set_column_property(n, "k", PropertyValue::String("column".into()));
@@ -151,7 +155,7 @@ fn export_prefers_the_row_value_over_the_column() {
     let id = dst.node_ids_by_label(&Label::new("Doc"), None)[0];
     assert_eq!(
         dst.node_property(id, "k"),
