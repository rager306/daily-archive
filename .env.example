# =============================================================================
# daily-archive v2 — Rust project environment configuration
# Architecture: ADR-037 (structure), ADR-038 (schema), ADR-039 (lifecycle)
#
# Copy to .env and fill in real values. Secrets must NEVER be committed.
# Use `secure_env_collect` to set secret values safely.
# =============================================================================

# ---------------------------------------------------------------------------
# SAFETY (binding — ADR-039, D127)
# These must stay false. Only explicit human action flips them per-session.
# ---------------------------------------------------------------------------
DA_IMPORT_ELIGIBLE=false
DA_GRAPH_WRITES_ALLOWED=false
DA_USER_GO=false
# Lifecycle stage: fixture | canary_10 | canary_60 | week_batch | production
DA_LIFECYCLE_STAGE=fixture

# ---------------------------------------------------------------------------
# Graph open mode (M305 / Wave 3 / M421)
# embedded (default) = process-local Samyama via open_graph_store
# remote = RESP read plane (RemoteGraphStore). HOT writes stay unsupported.
# Health multi-process path: `da serve-graph` + `da graph-ping` / `da graph-query --mode remote`
# ---------------------------------------------------------------------------
DA_GRAPH_MODE=embedded

# ---------------------------------------------------------------------------
# Read-only identity graph plane (M401 / T02, ADR-061)
# Server: `da serve-graph` composes kg-storage ReadOnlyServer over Samyama.
# Client: RemoteGraphStore (DA_GRAPH_MODE=remote path) talks the same RESP2
#   read-only contract: PING / ECHO / INFO / DA.IDENTITY / GRAPH.RO_QUERY.
# All mutation, index, vector, import and admin commands are rejected
# server-side before touching the store. DA.IDENTITY is a deterministic
# SnapshotIdentity JSON computed from the exported graph bytes.
# Unset keys fall back to defaults; blank/non-numeric/zero/overflow are
# rejected with a typed error — never a silent default.
# `da serve-graph` reads the DA_SERVE_GRAPH_* keys as env-aware clap args
# (explicit CLI flag > env > default).
# ---------------------------------------------------------------------------
# RemoteGraphStore client keys (default 127.0.0.1:16379, 5s timeout, 8MiB)
DA_REMOTE_GRAPH_ENDPOINT=127.0.0.1:16379
DA_REMOTE_GRAPH_TIMEOUT_SECONDS=5
DA_REMOTE_GRAPH_MAX_RESPONSE_BYTES=8388608
# Canonical remote endpoint is DA_REMOTE_GRAPH_ENDPOINT above.
# DA_GRAPH_ENDPOINT is an explicit alias (M421). If both are set to different
# values, resolution fails closed — no silent pick. No daemon auto-start.
DA_GRAPH_ENDPOINT=127.0.0.1:16379
# ReadOnlyServer keys (default 127.0.0.1:16379, 1MiB frame, 8MiB response,
# 10s op timeout, 100 connections)
DA_SERVE_GRAPH_HOST=127.0.0.1
DA_SERVE_GRAPH_PORT=16379
DA_SERVE_GRAPH_MAX_FRAME_BYTES=1048576
DA_SERVE_GRAPH_MAX_RESPONSE_BYTES=8388608
DA_SERVE_GRAPH_OPERATION_TIMEOUT_SECONDS=10
DA_SERVE_GRAPH_MAX_CONNECTIONS=100
# Cross-process verification (ADR-061, T04): start the daemon with a preload,
# then from a second process verify DA.IDENTITY and a read query, and send
# raw GRAPH.QUERY CREATE / GRAPH.DELETE to see them rejected with typed -ERR
# while read counts stay unchanged:
#   cargo test -p da-cli --test remote_read_plane_test

# RocksDB / PersistenceManager data dir — NOT wired for daily-archive CLI open (M332).
# Non-empty value causes honest PersistenceNotConfigured failure.
# Durability: da batch-ingest --output file.sgsnap (process-local memory otherwise).
# DA_GRAPH_DATA_PATH=


# ---------------------------------------------------------------------------
# Samyama Graph — Rust-native graph-vector database (ADR-040 §1 Tier 1)
# Vendor daemon (optional, not default CLI path):
#   cd vendor-source/samyama-graph && target/debug/samyama --port 6380 --http-port 8080
# daily-archive in-memory RESP (M308, no RocksDB):
#   da serve-graph --host 127.0.0.1 --port 16379
#   da graph-ping --port 16379
# SAMYAMA_RESP_PORT below is for the *vendor* daemon (6380), NOT da serve-graph (16379).
# ---------------------------------------------------------------------------
SAMYAMA_RESP_HOST=127.0.0.1
SAMYAMA_RESP_PORT=6380
SAMYAMA_HTTP_URL=http://127.0.0.1:8080
SAMYAMA_DATA_DIR=data/samyama
SAMYAMA_DEFAULT_TENANT=daily_archive
SAMYAMA_VENDOR_PATH=/root/vendor-source/samyama-graph

# ---------------------------------------------------------------------------
# RuVector — embedded agent brain (ADR-037 §7, vendor-source/ruvector/)
# Path deps: crates depend on /root/vendor-source/ruvector/crates/*
# ---------------------------------------------------------------------------
RUVECTOR_VENDOR_PATH=/root/vendor-source/ruvector
RUVECTOR_DATA_DIR=data/ruvector
RUVECTOR_DIMENSION=1024
RUVECTOR_DISTANCE_METRIC=cosine
RUVECTOR_HNSW_M=16
RUVECTOR_HNSW_EF_CONSTRUCTION=200
RUVECTOR_HNSW_EF_SEARCH=64
# Agent memory compaction
RUVECTOR_AGENT_MEMORY_MAX_ENTRIES=10000
RUVECTOR_AGENT_MEMORY_STRATEGY=coherence  # lru | lfu | coherence

# ---------------------------------------------------------------------------
# GROBID — PDF scholarly parser (Java HTTP, port 8070)
# No API key for CRF model. Deployed via .docker/docker-compose.yml
# ---------------------------------------------------------------------------
# GROBID REST API parameters (sent by da-adapters GrobidParser::process_fulltext):
#   consolidateCitations=1 — enrich references via Crossref/biblio-glutton
#     (adds DOI, venue, publisher, normalized author names). Critical for
#     ADR-053 Layer F cross-paper edges. Adds ~2-5s per paper.
#   consolidateHeader=1 — enrich paper header (title, authors, DOI, abstract)
#     via Crossref. Improves author disambiguation (Layer G) and DOI coverage.
#   teiCoordinates=["figure","table","note"] — add PDF coordinates for
#     figures, tables, footnotes. Enables Layer I figure image cropping.
# These are hardcoded in GrobidParser::process_fulltext (not env-configurable
# yet — they are always-on for consistent extraction quality).
# ---------------------------------------------------------------------------
GROBID_URL=http://127.0.0.1:8070
GROBID_HOST_PORT=8070
GROBID_IMAGE=grobid/grobid:0.9.0-crf
GROBID_CONTAINER_NAME=daily-archive-grobid
GROBID_JAVA_OPTS=-Xmx4g
GROBID_AUTO_START=true
GROBID_START_TIMEOUT_SECONDS=180
GROBID_COMPOSE_FILE=.docker/docker-compose.yml

# ---------------------------------------------------------------------------
# OpenDataLoader / MinerU — PDF layout parser (Python subprocess)
# MinerU = OpenDataLoader (Shanghai AI Lab OpenDataLab, same as Scholar-KG)
# Requires Python with opendataloader-pdf installed
# ---------------------------------------------------------------------------
ODL_PYTHON_BIN=python3
ODL_OUTPUT_FORMAT=json+markdown
ODL_AUTO_INSTALL=false
ODL_CONTAINER_NAME=daily-archive-opendataloader

# ---------------------------------------------------------------------------
# GLiNER 2 — offline zero-shot NER (Python subprocess, ADR-038 §3 Core stage)
# pip install gliner2[local] sentencepiece
# Model: fastino/gliner2-base-v1 (205M) or fastino/gliner2-large-v1 (340M)
# ---------------------------------------------------------------------------
GLINER2_PYTHON_BIN=python3
GLINER2_MODEL=fastino/gliner2-base-v1
GLINER2_THRESHOLD=0.3
GLINER2_MAX_BODY_CHARS=8000
GLINER2_NER_CONFIDENCE_FLOOR=0.3

# ---------------------------------------------------------------------------
# TEI Embedder (fd_api) — bge-m3 embeddings via ONNX (port 8000)
# GOTCHA: stale/wrong FD_API_KEY causes silent zero-vector degradation.
# Verify with live embed_all() smoke test before diagnosing errors.
# ---------------------------------------------------------------------------
FD_EMBEDDINGS_ENDPOINT=http://127.0.0.1:8000/v1/embeddings
TEI_URL=http://127.0.0.1:8000
FD_API_KEY=<your-fd-api-key-here>
MODEL_ID=deepvk/USER-bge-m3
FD_MODEL_NAME=deepvk/USER-bge-m3
FD_DIMENSIONS=1024
FD_BATCH_SIZE=32
FD_REQUEST_TIMEOUT_SECONDS=30
FD_MAX_RETRIES=3
FD_RETRY_BACKOFF_SECONDS=1,5,15,60,300
FD_CIRCUIT_FAILURE_THRESHOLD=3
FD_CIRCUIT_OPEN_SECONDS=60
FD_GRACEFUL_DEGRADATION_ENABLED=true

# Bounded HTTP retry/backoff for acquisition fetches (comma-list of seconds,
# one attempt per entry after the first; Python parity: 8*(attempt+1)).
# Only transient failures (timeout, 5xx, network) are retried; 4xx/validation fail closed.
DA_HTTP_RETRY_BACKOFF_SECONDS=1,5,15,60,300

# ArXiv provider endpoints (D239: provider roles in env, not code).
# Override for tests/mirrors; defaults are production arXiv.
DA_ARXIV_EXPORT_BASE_URL=https://export.arxiv.org
DA_ARXIV_ABS_BASE_URL=https://arxiv.org
DA_AR5IV_BASE_URL=https://ar5iv.labs.arxiv.org

# Redis (for fd_api queue + optional cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# 9router — local LLM proxy (primary LLM surface, port 20128)
# OpenAI-compatible: POST {NINEROUTER_URL}/v1/chat/completions
# Model roles resolve from models.yaml (not these env vars):
#   fast default: agnes-ai/agnes-2.0-flash
#   quality:      xai/grok-code-fast-1
#   fallback:     xai/grok-code-fast-1
#   judge:        glm-5.2 / gpt-5.4-mini
# MiniMax subscription is cancelled; do not add MINIMAX_* keys back.
# ---------------------------------------------------------------------------
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_KEY=

# ---------------------------------------------------------------------------
# GLM / Z.ai — secondary LLM + judge
# ---------------------------------------------------------------------------
ZAI_API_KEY=
GLM_MODEL=glm-5.2

# ---------------------------------------------------------------------------
# OpenAI (optional — for gpt judge models via 9router or direct)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Anthropic (optional — for claude judge models via 9router or direct)
# ---------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# D238 prompt/model registries. paper-summary-* bindings resolve through models.yaml;
# only the 9router host/key and bounded timeout are environment-specific.
DA_PROMPT_TASK_REGISTRY=data/ontology/prompt_tasks.yaml
DA_MODEL_REGISTRY=models.yaml
DA_LLM_TIMEOUT_SECONDS=300
# Optional override of the figure-analysis model binding in models.yaml.
# Unset keeps DATA route `figure-qa-primary` (Qwen-VL). Luna soak:
#   DA_FIGURE_MODEL_BINDING=figure-qa-luna
# Unknown ids fail closed at ModelRegistry::resolve — no silent fallback.
# DA_FIGURE_MODEL_BINDING=
# pdffigures2 detector JAR (required for --tables/--figures). Local path, not a secret.
# PDFFIGURES2_JAR=/root/vendor-source/scipdf_parser/scipdf/pdf/pdffigures2/pdffigures2-assembly-0.0.12-SNAPSHOT.jar
# Figure quote policy window (ADR-062): soft guideline vs absolute schema ceiling.
# Optional path override; default data/ontology/figure_quote_policy.yaml.
# DA_FIGURE_QUOTE_POLICY=data/ontology/figure_quote_policy.yaml

# ---------------------------------------------------------------------------
# arXiv API — paper ingestion source
# ---------------------------------------------------------------------------
ARXIV_API_BASE=http://export.arxiv.org/api/query
ARXIV_API_RATE_LIMIT_SECONDS=3
ARXIV_PDF_BASE_URL=https://arxiv.org/pdf
ARXIV_CATEGORY_DEFAULT=cs.AI

# ---------------------------------------------------------------------------
# Catalog + data paths (gitignored PDFs under data/)
# ---------------------------------------------------------------------------
DA_CATALOG_ROOT=data/article_catalog
DA_PDF_CACHE=artifacts/etl/gold-pdf-cache
DA_EVIDENCE_ROOT=artifacts/evidence
DA_RUNS_ROOT=artifacts/runs
DA_CANARY_GOLD=artifacts/m072-reviewed-extraction-benchmark/fixtures
DA_CANARY_DESIGN=artifacts/etl/canary-corpus-design.v1.json
DA_HELD_OUT_SPLIT=artifacts/etl/canary-held-out-split.v1.json

# ---------------------------------------------------------------------------
# ETL Scheduler (ADR-037 §4.3, resource-aware)
# ---------------------------------------------------------------------------
DA_MAX_CONCURRENT_TASKS=4
DA_LLM_RATE_LIMIT_PER_MINUTE=30
DA_CPU_BUDGET_PERCENT=75
DA_RAM_BUDGET_GB=16
DA_DISK_PAUSE_THRESHOLD_GB=5

# ---------------------------------------------------------------------------
# Logging + tracing (ADR-052)
# ---------------------------------------------------------------------------
# Structured logging: stderr (compact) + rolling JSON file; both use RUST_LOG/LOG_LEVEL.
# Logs go to LOG_DIR/da.log.YYYY-MM-DD (daily rotation, non-blocking writer)
RUST_LOG=info
RUST_LOG_DA_DOMAIN=info
RUST_LOG_DA_AGENT=debug
RUST_LOG_DA_GRAPH=info
RUST_BACKTRACE=1
RUST_LOG_FORMAT=full

# M359: file logging configuration
# LOG_DIR — directory for rolling log files (default: logs/)
LOG_DIR=logs
# LOG_LEVEL — filter level when RUST_LOG not set (default: info)
LOG_LEVEL=info
# File format is fixed JSON so operational evidence remains machine-queryable.

# ---------------------------------------------------------------------------
# Hybrid auto-start (parser sidecars + services)
# ---------------------------------------------------------------------------
HYBRID_AUTO_START_CONTAINERS=true

# ---------------------------------------------------------------------------
# ONNX embedder (optional, if using local RuVector OnnxEmbedding instead of fd_api)
# Feature-gated in ruvector-core: features=["onnx-embeddings"]
# Downloads model from HuggingFace on first use.
# ---------------------------------------------------------------------------
ONNX_EMBEDDER_MODEL=BAAI/bge-m3
ONNX_EMBEDDER_CACHE_DIR=data/onnx-models
ONNX_EMBEDDER_DIMENSION=1024

# ---------------------------------------------------------------------------
# Temporal defaults (ADR-037 §6, versioning)
# ---------------------------------------------------------------------------
DA_TEMPORAL_DEFAULT_VALID_FROM=2026-01-01T00:00:00Z
DA_TEMPORAL_RETAIN_HISTORY=true
DA_TEMPORAL_MAX_VERSIONS=100

# ── M440: catalog sweep materialization runner (catalog_materialize_runner) ──
# Canary limit for --run mode; 0 = all materializable papers (see coverage report).
# DA_MATERIALIZE_LIMIT=25
# Output .sgsnap snapshot path for --run mode.
# DA_MATERIALIZE_SNAPSHOT=artifacts/catalog_sweep/catalog_materialized.sgsnap
# Per-paper run report path for --run mode.
# DA_MATERIALIZE_RUN_REPORT=artifacts/catalog_sweep/materialization_run_report.json
# Recovery report path for --recover mode (M441).
# DA_MATERIALIZE_RECOVERY_REPORT=artifacts/catalog_sweep/materialization_recovery.json
# Merge a recovery report into --run target selection (upgrades no_tei_revision
# skips whose PDF stamp declared a version).
# DA_MATERIALIZE_RECOVERY=artifacts/catalog_sweep/materialization_recovery.json
# Resume an interrupted materialization run (M442): preload the existing
# snapshot, skip already-completed papers, merge records.
# DA_MATERIALIZE_RESUME=1
# Extraction dictionaries (M446 DATA-first; fallback = bundled snapshot).
# DA_EXTRACTION_PATTERNS=data/extraction_patterns.yaml
# OpenAlex endpoint override (M446; default https://api.openalex.org).
# OPENALEX_BASE_URL=
# DOI prefix dictionary path (M446 W-B1; source_code -> prefix).
# DA_DOI_PREFIX_MAP=data/ontology/doi_prefix_map.yaml

# ── M447/M450: centralized path configuration ──────────────────────────
# All paths are defined in data/path_config.yaml (single source of truth).
# Override individual paths via env vars:
# DA_PATH_CATALOG_ROOT=data/sources/arxiv
# DA_PATH_EXTRACTION_PATTERNS=data/extraction_patterns.yaml
# DA_PATH_NODE_SCHEMAS=data/ontology/node_schemas.yaml
# DA_ONTOLOGY_DIR=data/ontology
# DA_EXTRACTION_PATTERNS=data/extraction_patterns.yaml
# DA_DOI_PREFIX_MAP=data/ontology/doi_prefix_map.yaml

# Auto-discovered from code (wave 3 audit)
DA_DOI_PREFIX_MAP=data/ontology/doi_prefix_map.yaml
DA_EXTRACTION_PATTERNS=data/extraction_patterns.yaml (override path)
DA_FIGURE_MODEL_BINDING=(figure analysis model binding from models.yaml)
DA_FIGURE_QUOTE_POLICY=data/ontology/figure_quote_policy.yaml
DA_GRAPH_DATA_PATH=(graph data path for remote mode)
DA_MULTIMODAL_CONTEXT_SCHEMA=(figure context schema path)
DA_REGRESSION_TOLERANCE=0.0001
NINE_ROUTER_API_KEY=(9router API key)
OPENALEX_BASE_URL=https://api.openalex.org
DA_REVISION_ASSET_BASE_URL=
