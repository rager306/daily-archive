# fd v2 Embedding Service (M062-fd-v2-verification, 2026-06-15)
FD_EMBEDDINGS_ENDPOINT=http://127.0.0.1:8000/v1/embeddings
TEI_URL=http://127.0.0.1:8000
FD_API_KEY=<your-fd-api-key-here>  # NEW: required for fd v2 auth
MODEL_ID=deepvk/USER-bge-m3  # NEW: model identifier
REDIS_HOST=127.0.0.1  # NEW: for M064 queue
REDIS_PORT=6379
# legacy FD_* vars (kept for backward compat)
FD_MODEL_NAME=deepvk/USER-bge-m3
FD_EMBEDDINGS_ENDPOINT_BASE=http://127.0.0.1:8000
FD_DIMENSIONS=1024
FD_BATCH_SIZE=32
FD_REQUEST_TIMEOUT_SECONDS=30
FD_MAX_RETRIES=3
FD_RETRY_BACKOFF_SECONDS=1,5,15,60,300
FD_CIRCUIT_FAILURE_THRESHOLD=3
FD_CIRCUIT_OPEN_SECONDS=60
FD_GRACEFUL_DEGRADATION_ENABLED=true

# ---------------------------------------------------------------------------
# Parser sidecars (GROBID HTTP + OpenDataLoader library) — M212/M044
# No API keys required for default CRF GROBID. See .docker/README.md
# ---------------------------------------------------------------------------
GROBID_URL=http://127.0.0.1:8070
GROBID_HOST_PORT=8070
GROBID_IMAGE=grobid/grobid:0.9.0-crf
GROBID_CONTAINER_NAME=daily-archive-grobid
GROBID_JAVA_OPTS=-Xmx4g
GROBID_AUTO_START=true
GROBID_START_TIMEOUT_SECONDS=180
GROBID_COMPOSE_FILE=.docker/docker-compose.yml
# OpenDataLoader is primarily in-process (pip: opendataloader-pdf), not HTTP.
ODL_AUTO_INSTALL=false
ODL_CONTAINER_NAME=daily-archive-opendataloader
ODL_IMAGE=python:3.13-slim-bookworm
HYBRID_AUTO_START_CONTAINERS=true

# ---------------------------------------------------------------------------
# Local 9router LLM proxy (primary LLM surface; no external cloudcode path)
# OpenAI: POST {NINEROUTER_URL}/v1/chat/completions
# Anthropic: POST {NINEROUTER_URL}/v1/messages
# Roles: see models.yaml paper-summary-* bindings (default=agnes, quality=M2.7,
#         fallback=grok-code-fast-1). DSPy on agnes deferred.
# ---------------------------------------------------------------------------
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_KEY=
