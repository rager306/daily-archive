# fd v2 Embedding Service (M062-fd-v2-verification, 2026-06-15)
FD_EMBEDDINGS_ENDPOINT=http://127.0.0.1:8000/v1/embeddings
TEI_URL=http://127.0.0.1:8000
FD_API_KEY=<your-fd-api-key-here>  # NEW: required for fd v2 auth
MODEL_ID=deepvk/USER-bge-m3  # NEW: model identifier
REDIS_HOST=127.0.0.1  # NEW: for M064 queue
REDIS_PORT=6379
# legacy FD_* vars (kept for backward compat)
FD_MODEL_NAME=deepvk/USER-bge-m3
FD_EMBEDDINGS_ENDPOINT_BASE=http://127.0.0.1:8000
FD_DIMENSIONS=1024
FD_BATCH_SIZE=32
FD_REQUEST_TIMEOUT_SECONDS=30
FD_MAX_RETRIES=3
FD_RETRY_BACKOFF_SECONDS=1,5,15,60,300
FD_CIRCUIT_FAILURE_THRESHOLD=3
FD_CIRCUIT_OPEN_SECONDS=60
FD_GRACEFUL_DEGRADATION_ENABLED=true
